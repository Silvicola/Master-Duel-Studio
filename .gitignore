# ===================== Python =====================
__pycache__/
*.py[cod]
*$py.class
build/
*.egg-info/
.venv/
venv/
.pyenv/
env/

# ===================== .NET / WinUI 3 =====================
bin/
obj/
.vs/
*.user
*.suo
*.pdb
*.nupkg
*.appx
*.msix
AppPackages/

# ===================== 构建产物（开发目录特有，别入库）=====================
dist/
publish/
out/
*.zip
# 打包脚本收集出来的随包 Python 运行时（约 376MB）
python/

# ===================== 本机数据：游戏路径、账号、历史记录 =====================
data/
config/
settings.json
journal.json

# ===================== 模型与第三方大文件 =====================
# 抠像模型 176MB，超过 GitHub 单文件上限
tools/matting/*.onnx
*.onnx
*.pth
*.ckpt
# realesrgan 自带的示例视频与测试图
tools/realesrgan/*.mp4
tools/realesrgan/input*.jpg

# ===================== WorkBuddy / 编辑器 =====================
.workbuddy/
.vscode/
.idea/
*.swp
*.swo

# ===================== 运行时缓存与临时产物 =====================
# 根目录的 overframe/ 是早期调试留下的抓取结果，真正的缓存写在 data/overframe/
/overframe/
@AutomationLog.txt

# ===================== 系统与临时文件 =====================
Thumbs.db
Desktop.ini
.DS_Store
*.log
*.tmp
*.bak
*.orig
# 边框素材的取色底本就叫 .orig.png，是随包资源
!tools/overframe/*.orig.png
~$*
