<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MDStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:MDStudio.Controls"
    xmlns:local="using:MDStudio"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Master Duel Studio"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Shell">
        <Grid.Resources>
            <!--
                预览卡片：承载标题条与播放器。
                投影只加在里面的场地背景上（见 CutinPreview），卡片这层不再带阴影，
                否则两层阴影叠在一起，看着像贴了两层纸。这里只留 1px 描边与实心底。
            -->
            <Style x:Key="PreviewCard" TargetType="ContentControl">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Border
                                Background="{ThemeResource PanelFillBrush}"
                                BorderBrush="{ThemeResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource OverlayCornerRadius}">
                                <ContentPresenter
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Content="{TemplateBinding Content}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Master Duel Studio"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested" />

        <!--  预演模式胶囊：叠在标题栏上方、水平居中（用 TitleBar.Content 会靠左，所以单独叠一层）  -->
        <Button
            x:Name="DryRunBadge"
            Grid.Row="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#E65620"
            Click="DryRunBadge_Click"
            Foreground="White"
            Padding="12,4"
            Visibility="Collapsed">
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="预演模式" />
        </Button>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            IsPaneToggleButtonVisible="False"
            OpenPaneLength="180"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.Resources>
                <!--  选中的导航项：用强调色淡淡铺底，比默认灰更清楚  -->
                <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.18" />
                <!--  选中指示条用纯强调色，更显眼  -->
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource SystemAccentColor}" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="卡图"
                    Tag="cardart">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="壁纸"
                    Tag="wallpaper">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="动画与特效"
                    Tag="anim">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE714;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="分享"
                    Tag="share">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE898;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="历史"
                    Tag="history">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid>
                <Frame x:Name="NavFrame" />

                <!--
                    没有可用账号（或找不到游戏目录）时，内容区换成这一屏。
                    不是执行动作时那个带转圈的遮罩：它常驻、不挡动作、也不会自己消失。
                    放在 Frame 这一层而不是每个页面各写一个，六页只需维护一处。
                    背景保持透明，底下直接是 Mica，和其它页面同一种底；被挡时把 Frame
                    整个收起来，避免旧内容透出来。
                -->
                <Grid
                    x:Name="AccountBlock"
                    Visibility="Collapsed">
                    <StackPanel
                        MaxWidth="400"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                        <TextBlock
                            x:Name="BlockTitle"
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="还没有选择账号" />
                        <TextBlock
                            x:Name="BlockBody"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="BlockGo"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            Click="BlockGo_Click"
                            Content="去设置选择"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </NavigationView>

        <!--
            动画预览浮层：挂在窗口内容层，不挂页面。
            生成完在设置页点「预览」，就地看，不用先切回动画页；关掉还在原页面。
            遮罩只盖内容区，标题栏留着可拖动、可关窗。
        -->
        <Grid
            x:Name="PreviewLayer"
            Grid.Row="1"
            Background="#4D000000"
            Visibility="Collapsed">
            <ContentControl
                x:Name="PreviewHost"
                Width="880"
                Height="601"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource PreviewCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="16,0,8,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!--  与右侧功能区一致：卡名在上，「ID · 卡种」在下  -->
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock
                                x:Name="PreviewTitle"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="动画预览"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="PreviewSubtitle"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text=""
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4">
                            <TextBlock
                                x:Name="PreviewMeta"
                                MinWidth="132"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text=""
                                TextAlignment="Right" />
                            <Button
                                x:Name="PreviewCloseBtn"
                                Width="32"
                                Height="28"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="PreviewClose_Click"
                                ToolTipService.ToolTip="关闭（Esc）">
                                <FontIcon FontSize="12" Glyph="&#xE711;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <controls:CutinPreview x:Name="PreviewView" Grid.Row="1" />
                </Grid>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
