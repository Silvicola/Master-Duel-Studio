<UserControl
    x:Class="MDStudio.Controls.CutinPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:skia="using:SkiaSharp.Views.Windows"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            画布区：四周留 16 的空隙。这里才是要「描边 + 阴影」的那块
            （场地背景的边），卡片本身不再带投影。
            做法照抄动画页右侧功能区 PanelCard：画布右下各收 10，三层黑投影
            分别平移 4/6、2.5/4、1/2 探进那 10 的空间，再叠 1px 描边。
            右、下的格边距因此只留 6（6 + 10 = 16），画布在卡片里依旧居中。
            画布本身在 SizeChanged 里锁 16:9 居中，游戏里召唤动画就是铺满 16:9 全屏。
        -->
        <Grid Margin="16,16,6,6">
            <Border
                Margin="0,0,10,10"
                Background="{ThemeResource ElevationShadowBrush}"
                CornerRadius="6"
                Opacity="0.025">
                <Border.RenderTransform>
                    <TranslateTransform X="4" Y="6" />
                </Border.RenderTransform>
            </Border>
            <Border
                Margin="0,0,10,10"
                Background="{ThemeResource ElevationShadowBrush}"
                CornerRadius="6"
                Opacity="0.04">
                <Border.RenderTransform>
                    <TranslateTransform X="2.5" Y="4" />
                </Border.RenderTransform>
            </Border>
            <Border
                Margin="0,0,10,10"
                Background="{ThemeResource ElevationShadowBrush}"
                CornerRadius="6"
                Opacity="0.055">
                <Border.RenderTransform>
                    <TranslateTransform X="1" Y="2" />
                </Border.RenderTransform>
            </Border>
            <Border
                Margin="0,0,10,10"
                Background="#FCFCFC"
                BorderBrush="{ThemeResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid x:Name="Stage" SizeChanged="Stage_SizeChanged">
                    <skia:SKXamlCanvas
                        x:Name="Canvas"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        PaintSurface="OnPaint" />
                </Grid>
            </Border>
        </Grid>

        <!--
            工具条：独立一层，靠一条上边框与画布分开。
            中段「进度条 + 时间读数」整体居中（单看进度条会偏左，因为右边还跟着两个数字）；
            左右两列等宽，所以不管两侧按钮各自多宽，中段都落在卡片中线上。
            左右两组往内收 20 的边距，不贴卡片边缘。
        -->
        <Border
            Grid.Row="1"
            Padding="20,8"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="PrevFrame_Click"
                        ToolTipService.ToolTip="上一帧">
                        <FontIcon FontSize="13" Glyph="&#xE892;" />
                    </Button>
                    <Button
                        x:Name="PlayButton"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="Play_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="播放 / 暂停（空格）">
                        <FontIcon x:Name="PlayIcon" FontSize="13" Glyph="&#xE769;" />
                    </Button>
                    <Button
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="NextFrame_Click"
                        ToolTipService.ToolTip="下一帧">
                        <FontIcon FontSize="13" Glyph="&#xE893;" />
                    </Button>
                </StackPanel>

                <!--  进度条固定 260，不随窗口拉伸；时间紧跟其后，两者作为一组居中  -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Slider
                        x:Name="Seek"
                        Width="260"
                        IsThumbToolTipEnabled="False"
                        Maximum="1"
                        StepFrequency="0.001"
                        ValueChanged="Seek_ValueChanged" />
                    <TextBlock
                        x:Name="TimeText"
                        MinWidth="88"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="0.00 / 0.00"
                        TextAlignment="Right" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="SpeedBtn"
                        Height="32"
                        Padding="10,0"
                        ToolTipService.ToolTip="播放速度">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Name="SpeedText" FontSize="12" Text="1×" />
                            <FontIcon FontSize="8" Glyph="&#xE70D;" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="Top">
                                <MenuFlyoutItem
                                    Click="Speed_Click"
                                    Tag="0.5"
                                    Text="0.5×" />
                                <MenuFlyoutItem
                                    Click="Speed_Click"
                                    Tag="1"
                                    Text="1×" />
                                <MenuFlyoutItem
                                    Click="Speed_Click"
                                    Tag="2"
                                    Text="2×" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <!--
                        循环收成纯图标：带「循环」两个字时右组比左组宽 80，
                        中段就没法真居中。开关态由 ToggleButton 自带的强调色底表达。
                    -->
                    <ToggleButton
                        x:Name="LoopToggle"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="Loop_Click"
                        IsChecked="True"
                        ToolTipService.ToolTip="循环播放，关掉就播一遍停下">
                        <FontIcon FontSize="13" Glyph="&#xE8EE;" />
                    </ToggleButton>
                    <!--
                        音效开关：只有这张卡的特效挂着「能解出来」的音效时才出现，默认关。
                        内置在 data.unity3d 的那几条解不开，不显示这枚按钮。
                    -->
                    <ToggleButton
                        x:Name="SoundToggle"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="Sound_Click"
                        ToolTipService.ToolTip="音效，默认关"
                        Visibility="Collapsed">
                        <FontIcon x:Name="SoundIcon" FontSize="13" Glyph="&#xE74F;" />
                    </ToggleButton>
                    <Button
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="Background_Click"
                        ToolTipService.ToolTip="在场地线稿与纯黑之间切换">
                        <FontIcon x:Name="BgIcon" FontSize="13" Glyph="&#xE790;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
