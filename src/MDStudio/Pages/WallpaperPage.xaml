<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MDStudio.Pages.WallpaperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <TextBlock
            Grid.Row="0"
            Margin="20,16,20,4"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="壁纸" />

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                Padding="20,8,20,6"
                VerticalAlignment="Top"
                ColumnSpacing="10"
                RowSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!--  左：大厅壁纸  -->
                <ContentControl
                    Grid.Column="0"
                    Style="{StaticResource PanelCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="大厅壁纸" />
                            <TextBlock
                                x:Name="LobbyMeta"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="6aadf393（青眼亚白龙） · WallPaper0001_1 · 2048×1304"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="游戏当前" />
                            <Border
                                Height="150"
                                Background="Transparent"
                                BorderBrush="White"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Canvas x:Name="LobbyNowCanvas" Margin="1" />
                            </Border>

                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="你的图片" />
                            <Border
                                Height="150"
                                Background="Transparent"
                                BorderBrush="White"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Canvas x:Name="LobbyPickCanvas" Margin="1" />
                            </Border>
                        </StackPanel>

                        <StackPanel
                            Grid.Row="2"
                            VerticalAlignment="Bottom"
                            Spacing="8">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="要替换的大厅壁纸" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="88" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="LobbyPickBox"
                                    IsReadOnly="True"
                                    PlaceholderText="不选就不替换" />
                                <Button
                                    x:Name="LobbyPickBtn"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    Click="LobbyPickBtn_Click"
                                    Content="选择…" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="LobbyApplyBtn"
                                    Click="LobbyApplyBtn_Click"
                                    Content="确认替换"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    x:Name="LobbyRestoreBtn"
                                    Click="LobbyRestoreBtn_Click"
                                    Content="还原"
                                    IsEnabled="False" />
                                <Button Click="ReloadBtn_Click" Content="重新预览" />
                            </StackPanel>

                            <TextBlock
                                x:Name="LobbyStatusText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ContentControl>

                <!--  右：大厅背景  -->
                <ContentControl Grid.Column="1" Style="{StaticResource PanelCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="大厅背景" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="ShopBGBase 等 8 张 · 1920×1080 · 建议选择一张1920×1080的透明PNG图（第 9 格是你选的图）"
                                TextWrapping="Wrap" />

                            <!--  8 张游戏背景 + 1 张你的图 = 三行三列，代码里填  -->
                            <Grid
                                x:Name="ShopTiles"
                                Margin="0,2,0,0"
                                ColumnSpacing="10"
                                RowSpacing="8" />
                        </StackPanel>

                        <StackPanel
                            Grid.Row="2"
                            VerticalAlignment="Bottom"
                            Spacing="8">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="要替换的大厅背景" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="88" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="ShopPickBox"
                                    IsReadOnly="True"
                                    PlaceholderText="不选就不替换" />
                                <Button
                                    x:Name="ShopPickBtn"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    Click="ShopPickBtn_Click"
                                    Content="选择…" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="ShopApplyBtn"
                                    Click="ShopApplyBtn_Click"
                                    Content="确认替换"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    x:Name="ShopRestoreBtn"
                                    Click="ShopRestoreBtn_Click"
                                    Content="还原"
                                    IsEnabled="False" />
                                <Button Click="ReloadBtn_Click" Content="重新预览" />
                            </StackPanel>

                            <TextBlock
                                x:Name="ShopStatusText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ContentControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
