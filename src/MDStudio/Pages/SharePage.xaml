<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MDStudio.Pages.SharePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MDStudio.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <StackPanel Grid.Row="0" Padding="20,16,20,4" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="整合包" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="把你做过的卡打包分享给别人，或安装别人做好的整合包。" />
        </StackPanel>

        <!--
            内容：左「导出」，右侧上下分「查看」「安装」。
            三块都用 PanelCard 样式，与卡片页两个主面板同一套边缘处理（不透明底 + 描边 + 柔和投影）。
        -->
        <Grid
            Grid.Row="1"
            Padding="16,6,16,10"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左：导出  -->
            <ContentControl Grid.Column="0" Style="{StaticResource PanelCard}">
                <!--  内容从上往下排，不留中间空洞；列表给上限，卡多了自己滚  -->
                <Grid RowSpacing="8" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="导出" />
                    <TextBlock
                        Grid.Row="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="勾选要打包的卡，导出成压缩包或文件夹，发给别人即可安装。"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="ExportEmpty"
                        Grid.Row="2"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="你还没有做过任何改动，暂无可导出的卡。"
                        Visibility="Collapsed" />

                    <ListView
                        x:Name="ExportList"
                        Grid.Row="3"
                        MaxHeight="280"
                        ScrollViewer.VerticalScrollBarVisibility="Visible"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PackCardItem">
                                <Grid Padding="0,2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        Grid.Column="0"
                                        MinWidth="0"
                                        VerticalAlignment="Center"
                                        IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Label}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Kinds}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid Grid.Row="4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="PackNameBox"
                            Grid.Column="0"
                            Header="包名"
                            PlaceholderText="my-pack" />
                        <ComboBox
                            x:Name="FormatBox"
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Header="格式"
                            SelectedIndex="0">
                            <x:String>ZIP 压缩包</x:String>
                            <x:String>文件夹</x:String>
                        </ComboBox>
                    </Grid>
                    <Button
                        x:Name="ExportBtn"
                        Grid.Row="5"
                        HorizontalAlignment="Left"
                        Click="ExportBtn_Click"
                        Content="导出" />
                </Grid>
            </ContentControl>

            <!--  右：上「查看」下「安装」  -->
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  查看  -->
                <ContentControl Grid.Row="0" Style="{StaticResource PanelCard}">
                    <Grid RowSpacing="8" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="查看" />
                        <TextBlock
                            Grid.Row="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="先选一个整合包，看看里面有哪些卡、哪些类型，再决定要不要安装。"
                            TextWrapping="Wrap" />

                        <Grid Grid.Row="2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="InspectPathBox"
                                Grid.Column="0"
                                Header="整合包"
                                IsReadOnly="True"
                                PlaceholderText="未选择" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal"
                                Spacing="6">
                                <Button
                                    x:Name="InspectBrowseBtn"
                                    Click="InspectBrowseBtn_Click"
                                    Content="选择文件" />
                                <Button
                                    x:Name="InspectBrowseDirBtn"
                                    Click="InspectBrowseDir_Click"
                                    Content="选择文件夹" />
                            </StackPanel>
                        </Grid>

                        <Button
                            x:Name="InspectBtn"
                            Grid.Row="3"
                            HorizontalAlignment="Left"
                            Click="InspectBtn_Click"
                            Content="查看" />

                        <!--  查看结果主要走弹出框, 这里留一行摘要, 关掉弹窗后也知道刚才看了什么  -->
                        <TextBlock
                            x:Name="InspectSummary"
                            Grid.Row="4"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </Grid>
                </ContentControl>

                <!--  安装  -->
                <ContentControl Grid.Row="1" Style="{StaticResource PanelCard}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="安装" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="选一个本工具导出的整合包。只接受本工具自己的卡条目，游戏文件不会被改动。"
                            TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="InstallPathBox"
                                Grid.Column="0"
                                Header="整合包"
                                IsReadOnly="True"
                                PlaceholderText="未选择" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal"
                                Spacing="6">
                                <Button
                                    x:Name="InstallBrowseBtn"
                                    Click="InstallBrowseBtn_Click"
                                    Content="选择文件" />
                                <Button
                                    x:Name="InstallBrowseDirBtn"
                                    Click="InstallBrowseDir_Click"
                                    Content="选择文件夹" />
                            </StackPanel>
                        </Grid>
                        <!--  勾选项与安装按钮同一行, 省一截高度留给「查看」  -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="16">
                                <CheckBox
                                    x:Name="SkipExistingBox"
                                    Content="跳过已安装的卡"
                                    IsChecked="True" />
                                <CheckBox x:Name="ReplaceBox" Content="覆盖已有" />
                            </StackPanel>
                            <Button
                                x:Name="InstallBtn"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Click="InstallBtn_Click"
                                Content="安装" />
                        </Grid>
                    </StackPanel>
                </ContentControl>
            </Grid>
        </Grid>

        <!--  底部：进度与日志  -->
        <StackPanel
            x:Name="StatusStrip"
            Grid.Row="2"
            Padding="20,8,20,12"
            Spacing="6"
            Visibility="Collapsed">
            <!--  空闲时折叠: 进度条轨道本身就是一条整宽横线, 留着会被当成多余的分隔线  -->
            <ProgressBar
                x:Name="Progress"
                Height="2"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="StatusText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="就绪" />
        </StackPanel>
    </Grid>
</Page>
