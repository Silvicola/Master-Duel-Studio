<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MDStudio.Pages.SharePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MDStudio.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
            预览弹窗里的一行。弹窗内容在代码里拼（要带勾选与状态），
            行模板放这里，代码用 Resources["PreviewRowTemplate"] 取。
        -->
        <DataTemplate x:Key="PreviewRowTemplate" x:DataType="models:PackPreviewItem">
            <StackPanel Spacing="2">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="148" />
                    <ColumnDefinition Width="148" />
                    <ColumnDefinition Width="148" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{x:Bind Label}"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6">
                    <CheckBox
                        MinWidth="0"
                        Content="动画"
                        IsChecked="{x:Bind Cutin, Mode=TwoWay}"
                        IsEnabled="{x:Bind CutinEnabled}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Opacity="0.6"
                        Text="{x:Bind CutinTag}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="6">
                    <CheckBox
                        MinWidth="0"
                        Content="特效"
                        IsChecked="{x:Bind Runfx, Mode=TwoWay}"
                        IsEnabled="{x:Bind RunfxEnabled}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Opacity="0.6"
                        Text="{x:Bind RunfxTag}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="3"
                    Orientation="Horizontal"
                    Spacing="6">
                    <CheckBox
                        MinWidth="0"
                        Content="超框"
                        IsChecked="{x:Bind Art, Mode=TwoWay}"
                        IsEnabled="{x:Bind ArtEnabled}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Opacity="0.6"
                        Text="{x:Bind ArtTag}" />
                </StackPanel>
            </Grid>
            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind BlockNote}"
                TextWrapping="Wrap"
                Visibility="{x:Bind BlockVisibility}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <!--
        顶部不放大标题：导航栏已经写着「分享」，再来一行 28px 大字只是把内容往下推。
        第一行固定 55，说明句压在这条留白带里靠下，面板顶边就落在和卡图页、
        动画页同一条线上，切页时不会上下跳。
    -->
    <Grid Padding="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="55" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="PageHint"
            Grid.Row="0"
            Margin="0,0,0,10"
            VerticalAlignment="Bottom"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="把你做过的卡打包分享给别人，或安装别人做好的整合包。" />

        <Grid
            Grid.Row="1"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左：导出  -->
            <ContentControl Grid.Column="0" Style="{StaticResource PanelCard}">
                <Grid RowSpacing="8" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="导出整合包" />
                    <TextBlock
                        Grid.Row="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="勾选每张卡要打包的内容。动画、特效、超框可各选；音效不在整合包里，装到的卡会用对方机器上的声音。"
                        TextWrapping="Wrap" />

                    <TextBox
                        x:Name="ExportSearchBox"
                        Grid.Row="2"
                        PlaceholderText="按卡名或卡号搜索"
                        TextChanged="ExportSearchBox_TextChanged" />

                    <TextBlock
                        x:Name="ExportEmpty"
                        Grid.Row="3"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="你还没有做过任何改动，暂无可导出的卡。"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <ListView
                        x:Name="ExportList"
                        Grid.Row="3"
                        MaxHeight="300"
                        ScrollViewer.VerticalScrollBarVisibility="Visible"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PackCardItem">
                                <Grid Padding="0,2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Label}"
                                        TextTrimming="CharacterEllipsis" />
                                    <CheckBox
                                        Grid.Column="1"
                                        MinWidth="0"
                                        Content="动画"
                                        IsChecked="{x:Bind Cutin, Mode=TwoWay}"
                                        IsEnabled="{x:Bind HasCutin}" />
                                    <CheckBox
                                        Grid.Column="2"
                                        MinWidth="0"
                                        Content="特效"
                                        IsChecked="{x:Bind Runfx, Mode=TwoWay}"
                                        IsEnabled="{x:Bind HasRunfx}" />
                                    <CheckBox
                                        Grid.Column="3"
                                        MinWidth="0"
                                        Content="超框"
                                        IsChecked="{x:Bind Art, Mode=TwoWay}"
                                        IsEnabled="{x:Bind HasArt}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid Grid.Row="4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="PackNameBox"
                            Grid.Column="0"
                            Header="包名"
                            PlaceholderText="导出" />
                        <Button
                            x:Name="ExportBtn"
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Click="ExportBtn_Click"
                            Content="选择位置并导出"
                            Style="{StaticResource AccentButtonStyle}" />
                    </Grid>

                    <TextBlock
                        x:Name="ExportHint"
                        Grid.Row="5"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                </Grid>
            </ContentControl>

            <!--  右：导入 + 装过的包  -->
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ContentControl Grid.Row="0" Style="{StaticResource PanelCard}">
                    <Grid RowSpacing="8" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="导入整合包" />
                        <TextBlock
                            Grid.Row="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="选一个本工具导出的压缩包，预览里挑好再装，取消就是只看。"
                            TextWrapping="Wrap" />

                        <Grid Grid.Row="2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="PackPathBox"
                                Grid.Column="0"
                                Header="整合包"
                                IsReadOnly="True"
                                PlaceholderText="未选择" />
                            <Button
                                x:Name="PackBrowseBtn"
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Click="PackBrowseBtn_Click"
                                Content="选择压缩包" />
                        </Grid>

                        <StackPanel
                            Grid.Row="3"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Name="InstallBtn"
                                Click="InstallBtn_Click"
                                Content="预览并安装"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </ContentControl>

                <ContentControl Grid.Row="1" Style="{StaticResource PanelCard}">
                    <Grid RowSpacing="8" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="装过的包" />
                        <TextBlock
                            x:Name="InstalledEmpty"
                            Grid.Row="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="还没有装过别人做的包。"
                            TextWrapping="Wrap" />

                        <ListView
                            x:Name="InstalledList"
                            Grid.Row="1"
                            MaxHeight="220"
                            ScrollViewer.VerticalScrollBarVisibility="Visible"
                            SelectionMode="None"
                            Visibility="Collapsed">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:PackInstalledItem">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind When}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Summary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </ContentControl>
            </Grid>
        </Grid>

        <!--  底部：进度与日志  -->
        <StackPanel
            x:Name="StatusStrip"
            Grid.Row="2"
            Padding="20,8,20,12"
            Spacing="6"
            Visibility="Collapsed">
            <!--  空闲时折叠: 进度条轨道本身就是一条整宽横线, 留着会被当成多余的分隔线  -->
            <ProgressBar
                x:Name="Progress"
                Height="2"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="StatusText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="就绪" />
        </StackPanel>
    </Grid>
</Page>
