<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MDStudio.Pages.AnimPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MDStudio.Converters"
    xmlns:models="using:MDStudio.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StatusBrushConverter x:Key="StatusBrush" />

        <!--
            参数框的上下调节按钮。NumberBox 内置的那两枚是框架主题字典里编译期绑定的样式，
            固定 32px 宽、两枚加间距吃掉 76px，四列参数框里太挤，App 级同名样式覆盖不到。
            所以内置按钮关掉，用这枚 18×22 的窄按钮代替，两枚只要 40px。
        -->
        <Style x:Key="NarrowSpinButton" TargetType="RepeatButton">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <DataTemplate x:Key="EffectRow" x:DataType="models:EffectItem">
            <Grid Padding="12,8">
                <StackPanel Spacing="2">
                    <TextBlock
                        MaxLines="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind SubLine}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,8,24,24" ColumnSpacing="12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左：卡片列表  -->
        <Grid Grid.Row="0">
            <!--  三层阶梯投影：ThemeShadow 在 Mica 窗口里不渲染，靠透明度递减模拟柔和衰减  -->
            <Border
                Margin="0,0,10,10"
                Background="{ThemeResource ElevationShadowBrush}"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Opacity="0.025">
                <Border.RenderTransform>
                    <TranslateTransform X="4" Y="6" />
                </Border.RenderTransform>
            </Border>
            <Border
                Margin="0,0,10,10"
                Background="{ThemeResource ElevationShadowBrush}"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Opacity="0.04">
                <Border.RenderTransform>
                    <TranslateTransform X="2.5" Y="4" />
                </Border.RenderTransform>
            </Border>
            <Border
                Margin="0,0,10,10"
                Background="{ThemeResource ElevationShadowBrush}"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Opacity="0.055">
                <Border.RenderTransform>
                    <TranslateTransform X="1" Y="2" />
                </Border.RenderTransform>
            </Border>
            <Border
                x:Name="LeftPanel"
                Margin="0,0,10,10"
                Background="{ThemeResource PanelFillBrush}"
                BorderBrush="{ThemeResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
            <Grid Padding="12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBox
                    x:Name="SearchBox"
                    PlaceholderText="搜索卡名或编号"
                    TextChanged="SearchBox_TextChanged" />

                <!--
                    按卡片上的标签筛选. 状态互斥, 所以用单选.
                    不给「无」这一档: 列表只收有动画或有特效的卡, 这里的「无」指的是
                    「另一半没有」, 跟「这张卡什么都没」不是一回事, 放在一起会误导.
                -->
                <Grid
                    Grid.Row="1"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        x:Name="CutinFilterBox"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="0"
                        SelectionChanged="FilterBox_SelectionChanged">
                        <ComboBoxItem Content="全部动画" Tag="" />
                        <ComboBoxItem Content="官方动画" Tag="official" />
                        <ComboBoxItem Content="自改动画" Tag="self" />
                    </ComboBox>

                    <ComboBox
                        x:Name="RunfxFilterBox"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="0"
                        SelectionChanged="FilterBox_SelectionChanged">
                        <ComboBoxItem Content="全部特效" Tag="" />
                        <ComboBoxItem Content="官方特效" Tag="official" />
                        <ComboBoxItem Content="自改特效" Tag="self" />
                    </ComboBox>
                </Grid>

                <!--  筛出来是空的时候, 光靠底部那行字容易看成卡住了  -->
                <TextBlock
                    x:Name="EmptyHint"
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="没有符合条件的卡"
                    Visibility="Collapsed" />

                <!--
                    右侧留 ScrollBarSize(16)：WinUI 的滚动条是覆盖式浮层，
                    条目横向撑满会被它压住，选中框右边就被裁掉一截。
                -->
                <ListView
                    x:Name="CardList"
                    Grid.Row="2"
                    Padding="0,0,16,0"
                    SelectionChanged="CardList_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Grid x:Name="RootGrid">
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <!--
                                                        每个状态都显式写全 背景/边框/指示条 三个属性。
                                                        留空的 VisualState 不会把上一个状态动画过的值复位，
                                                        旧高亮就会残留到别的行上。
                                                    -->
                                                    <VisualState x:Name="Normal">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TransparentBrush}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TransparentBrush}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="PointerOver">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TransparentBrush}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="Pressed">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TransparentBrush}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <!--
                                                        命名必须用 ListViewItem 的真实状态名：PointerOverSelected / PressedSelected。
                                                        写成 SelectedPointerOver 不会命中，鼠标停在选中项上会回落到 PointerOver 的灰底。
                                                    -->
                                                    <VisualState x:Name="Selected">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardSelectedBackground}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardSelectedBorder}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="PointerOverSelected">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardSelectedBackground}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardSelectedBorder}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="PressedSelected">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardSelectedBackground}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardSelectedBorder}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                            <Border
                                                x:Name="SelectionBorder"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle
                                                        x:Name="Indicator"
                                                        Grid.Column="0"
                                                        Fill="{ThemeResource CardSelectedIndicatorBrush}"
                                                        Opacity="0" />
                                                    <ContentPresenter
                                                        Grid.Column="1"
                                                        Margin="{TemplateBinding Padding}"
                                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                        Content="{TemplateBinding Content}"
                                                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:CardItem">
                            <Grid Padding="12,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        MaxLines="1"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind IdText}" />
                                </StackPanel>
                                <!--  召唤动画 + 发动特效: 两个带颜色的状态标签  -->
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{x:Bind KindCutin, Converter={StaticResource StatusBrush}}"
                                        Text="{x:Bind TagCutin}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{x:Bind KindRunfx, Converter={StaticResource StatusBrush}}"
                                        Text="{x:Bind TagRunfx}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
        </Grid>

        <!--  右：选中卡的工作台  -->
        <Grid Grid.Row="0" Grid.Column="1">
            <!--  三层阶梯投影，与左面板同一套节奏  -->
            <Border
                Margin="0,0,10,10"
                Background="{ThemeResource ElevationShadowBrush}"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Opacity="0.025">
                <Border.RenderTransform>
                    <TranslateTransform X="4" Y="6" />
                </Border.RenderTransform>
            </Border>
            <Border
                Margin="0,0,10,10"
                Background="{ThemeResource ElevationShadowBrush}"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Opacity="0.04">
                <Border.RenderTransform>
                    <TranslateTransform X="2.5" Y="4" />
                </Border.RenderTransform>
            </Border>
            <Border
                Margin="0,0,10,10"
                Background="{ThemeResource ElevationShadowBrush}"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Opacity="0.055">
                <Border.RenderTransform>
                    <TranslateTransform X="1" Y="2" />
                </Border.RenderTransform>
            </Border>
            <Border
                x:Name="RightPanel"
                Margin="0,0,10,10"
                Background="{ThemeResource PanelFillBrush}"
                BorderBrush="{ThemeResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
            <!--  右内边距故意比左小 14：给 ScrollViewer 的浮层滚动条留槽，
                  内容本身靠 ScrollViewer 的 Padding 补回 24，左右仍然对齐  -->
            <Grid Padding="24,24,10,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ScrollViewer
                    x:Name="DetailScroller"
                    Grid.Row="0"
                    HorizontalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <!--  右侧 Margin 14 给 ScrollViewer 的浮层滚动条留槽（ScrollViewer.Padding 在模板里不生效）  -->
                    <Grid x:Name="DetailContent" Margin="0,0,14,0">
                        <!--  空状态  -->
                        <StackPanel
                            x:Name="EmptyState"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="从左边选一张卡" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="选中后这里会显示这张卡的召唤动画与发动特效" />
                        </StackPanel>

                        <!--  卡片详情  -->
                        <StackPanel
                            x:Name="DetailPanel"
                            Spacing="12"
                            Visibility="Collapsed">
                            <!--  卡名 + 卡号一行：卡号用小字贴在名字右侧  -->
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock
                                    x:Name="CardName"
                                    Style="{StaticResource TitleTextBlockStyle}"
                                    Text="—" />
                                <TextBlock
                                    x:Name="CardMeta"
                                    VerticalAlignment="Bottom"
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="—" />
                            </StackPanel>

                            <SelectorBar
                                x:Name="SectionBar"
                                SelectionChanged="SectionBar_SelectionChanged">
                                <!--
                                    默认选中态只管一条 3px 细线，文字颜色与未选中相同（都指向
                                    TextFillColorPrimaryBrush），两个页签分不出来。这里让选中项用强调色，
                                    下划线也用强调色，才有明确的“当前在哪一页”的线索。
                                -->
                                <SelectorBar.Resources>
                                    <SolidColorBrush x:Key="SelectorBarItemForegroundSelected" Color="{ThemeResource SystemAccentColor}" />
                                    <SolidColorBrush x:Key="SelectorBarItemPillFill" Color="{ThemeResource SystemAccentColor}" />
                                </SelectorBar.Resources>
                                <SelectorBarItem
                                    IsSelected="True"
                                    Tag="cutin"
                                    Text="修改召唤动画" />
                                <SelectorBarItem x:Name="FxTab" Tag="runfx" Text="修改发动特效" />
                            </SelectorBar>

                            <StackPanel x:Name="CutinSection" Spacing="12">
                                                                                        <!--  来源卡 + 源卡预设: 只在无官方动画的卡上显示,
                                 官方卡默认拿自己当来源卡, 不用选  -->
                            <StackPanel x:Name="DonorPanel" Spacing="8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock VerticalAlignment="Center" Text="来源卡" />
                                        <AutoSuggestBox
                                            x:Name="DonorBox"
                                            MinWidth="240"
                                            PlaceholderText="搜卡名或编号"
                                            TextMemberPath="Display"
                                            SuggestionChosen="DonorBox_SuggestionChosen"
                                            TextChanged="DonorBox_TextChanged">
                                            <AutoSuggestBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:CardItem">
                                                    <TextBlock Text="{x:Bind Display}" />
                                                </DataTemplate>
                                            </AutoSuggestBox.ItemTemplate>
                                        </AutoSuggestBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock VerticalAlignment="Center" Text="源卡预设" />
                                        <ComboBox
                                            x:Name="DonorPresetBox"
                                            MinWidth="130"
                                            PlaceholderText="按召唤类型选"
                                            SelectionChanged="DonorPresetBox_SelectionChanged" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="2"
                                        Margin="0,0,14,0"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                        <Button x:Name="RefreshButton" Click="RefreshButton_Click" Content="刷新" />
                                        <Button
                                            x:Name="RemoveButton"
                                            Click="RemoveButton_Click"
                                            Content="复原" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="把来源卡的整套召唤动画复制给这张卡，来源卡不受影响。按召唤类型挑，节奏才对得上。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!--  生成召唤动画  -->
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource WellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="从视频/GIF/帧文件夾导入" />

                                    <!--  素材行  -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="SourceBox"
                                            IsReadOnly="True"
                                            PlaceholderText="选择视频、GIF或帧文件夾" />
                                        <Button
                                            x:Name="BrowseFileButton"
                                            Grid.Column="1"
                                            MinWidth="92"
                                            Click="BrowseFile_Click"
                                            Content="视频/GIF" />
                                        <Button
                                            x:Name="BrowseFolderButton"
                                            Grid.Column="2"
                                            MinWidth="80"
                                            Click="BrowseFolder_Click"
                                            Content="文件夾" />
                                        <StackPanel
                                            Grid.Column="3"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Button
                                                x:Name="BuildButton"
                                                MinWidth="128"
                                                Click="BuildButton_Click"
                                                Content="生成召唤动画"
                                                Style="{StaticResource AccentButtonStyle}" />
                                            <Button
                                                x:Name="CancelButton"
                                                Click="CancelButton_Click"
                                                Content="取消"
                                                Visibility="Collapsed" />
                                        </StackPanel>
                                    </Grid>

                                    <!--  方案 + 超分 + 弹出效果: 同一行。
                                         三个下拉都定死窄宽（原来铺满时「默认」「关闭」这种两个字也占 130px），
                                         省下的宽度用三根弹簧均分，左右两端仍贴齐整块控件的边。  -->
                                    <Grid x:Name="TopRowGrid" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition x:Name="EffectColumn" Width="104" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Text="方案" />
                                        <ComboBox
                                            x:Name="SchemeBox"
                                            Grid.Column="1"
                                            MinWidth="0"
                                            HorizontalAlignment="Stretch"
                                            DropDownClosed="SchemeBox_DropDownClosed"
                                            SelectionChanged="SchemeBox_SelectionChanged" />
                                        <StackPanel
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                            <Button
                                                x:Name="SchemeSaveButton"
                                                Click="SchemeSave_Click"
                                                ToolTipService.ToolTip="保存为方案"
                                                Width="34"
                                                Height="32"
                                                Padding="0">
                                                <FontIcon
                                                    FontSize="16"
                                                    Foreground="#0F7B0F"
                                                    Glyph="&#xE74E;" />
                                            </Button>
                                            <Button
                                                x:Name="SchemeDeleteButton"
                                                Click="SchemeDelete_Click"
                                                ToolTipService.ToolTip="删除选中的方案"
                                                Width="34"
                                                Height="32"
                                                Padding="0">
                                                <FontIcon
                                                    FontSize="16"
                                                    Foreground="#C42B1C"
                                                    Glyph="&#xE74D;" />
                                            </Button>
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="4"
                                            VerticalAlignment="Center"
                                            Text="超分" />
                                        <ComboBox
                                            x:Name="UpscaleBox"
                                            Grid.Column="5"
                                            MinWidth="0"
                                            HorizontalAlignment="Stretch"
                                            SelectedIndex="0"
                                            VerticalAlignment="Center">
                                            <ComboBoxItem Content="关闭" Tag="0" />
                                            <ComboBoxItem Content="超分 2×" Tag="2" />
                                            <ComboBoxItem Content="超分 4×" Tag="4" />
                                        </ComboBox>

                                        <StackPanel
                                            Grid.Column="7"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                            <TextBlock VerticalAlignment="Center" Text="弹出效果" />
                                            <CheckBox
                                                x:Name="PopBox" MinWidth="0" Padding="0"
                                                VerticalAlignment="Center"
                                                Checked="PopBox_Toggled"
                                                Unchecked="PopBox_Toggled" />
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="CurveLabel"
                                            Grid.Column="9"
                                            VerticalAlignment="Center"
                                            Text="效果"
                                            Visibility="Collapsed" />
                                        <ComboBox
                                            x:Name="CurvePresetBox"
                                            Grid.Column="10"
                                            MinWidth="0"
                                            HorizontalAlignment="Stretch"
                                            SelectedIndex="0"
                                            Visibility="Collapsed"
                                            SelectionChanged="CurvePresetBox_SelectionChanged">
                                            <ComboBoxItem Content="默认" />
                                            <ComboBoxItem Content="自定义" />
                                        </ComboBox>
                                    </Grid>

                                    <!--  参数: 四列定宽 + 三条弹簧，行内左右两端仍贴齐整块控件的边。
                                         定宽是为了让框本身收短（纯等分时框会把整列撑满），
                                         弹簧吃掉剩下的宽度，相邻两框之间因此有均匀的空隙。  -->
                                    <Grid
                                        x:Name="ParamsGrid"
                                        RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="136" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="136" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="136" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="136" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <NumberBox x:Name="FramesBox" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" Header="帧数" Maximum="200" Minimum="4" SpinButtonPlacementMode="Inline" Value="120" />
                                        <NumberBox x:Name="DurBox" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch" Header="时长（秒）" Maximum="15" Minimum="0.4" SmallChange="0.1" SpinButtonPlacementMode="Inline" Value="4.8" />
                                        <NumberBox x:Name="CellBox" Grid.Row="0" Grid.Column="4" HorizontalAlignment="Stretch" Header="像素/帧" Maximum="2048" Minimum="128" SmallChange="10" SpinButtonPlacementMode="Inline" Value="1080" />
                                        <NumberBox x:Name="SizeBox" Grid.Row="0" Grid.Column="6" HorizontalAlignment="Stretch" Header="角色尺寸（px）" Maximum="8000" Minimum="500" SmallChange="50" SpinButtonPlacementMode="Inline" Value="4800" />
                                        <NumberBox x:Name="OffXBox" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" Header="左右移（px）" SmallChange="10" SpinButtonPlacementMode="Inline" Value="0" />
                                        <NumberBox x:Name="OffYBox" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" Header="上下移（px）" SmallChange="10" SpinButtonPlacementMode="Inline" Value="0" />
                                        <NumberBox x:Name="RotBox" Grid.Row="1" Grid.Column="4" HorizontalAlignment="Stretch" Header="旋转（度）" Maximum="180" Minimum="-180" SmallChange="1" SpinButtonPlacementMode="Inline" Value="0" />
                                        <NumberBox x:Name="ZoomBox" Grid.Row="1" Grid.Column="6" HorizontalAlignment="Stretch" Header="放大倍数" Maximum="4" Minimum="0.2" SmallChange="0.1" SpinButtonPlacementMode="Inline" Value="1.1" />
                                    </Grid>

                                </StackPanel>
                            </Border>

                            <!--  从 Spine 导入  -->
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource WellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="从 Spine 导入" />

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="SpineSourceBox"
                                            IsReadOnly="True"
                                            PlaceholderText="Spine 导出文件夹、zip 或 bundle" />
                                        <Button
                                            Grid.Column="1"
                                            Click="SpineBrowseFolder_Click"
                                            Content="文件夹…" />
                                        <Button
                                            Grid.Column="2"
                                            Click="SpineBrowseFile_Click"
                                            Content="文件…" />
                                        <Button
                                            x:Name="SpineImportButton"
                                            Grid.Column="3"
                                            Click="SpineImportButton_Click"
                                            Content="导入到这张卡"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            </StackPanel>

                            <!--  发动特效  -->
                            <StackPanel x:Name="RunfxSection" Spacing="12" Visibility="Collapsed">
                                <StackPanel
                                    x:Name="FxBar"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="Collapsed">
                                    <FontIcon
                                        VerticalAlignment="Top"
                                        FontSize="14"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        Glyph="&#xE7BA;" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="这张卡官方自带发动特效。借用或自制都会覆盖它，点「复原」可以还原。"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <!--  借用整条特效  -->
                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource WellBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Padding="14">
                                    <StackPanel Spacing="10">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="借用游戏里的特效" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="把另一张卡的特效整条搬过来，每次发动都会播。"
                                            TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                x:Name="FxBorrowButton"
                                                Click="FxBorrowButton_Click"
                                                Content="选择特效…"
                                                Style="{StaticResource AccentButtonStyle}" />
                                            <Button
                                                x:Name="FxRemoveButton"
                                                Click="FxRemoveButton_Click"
                                                Content="复原" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!--  用视频自制：素材行 + 参数 + 声音开关  -->
                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource WellBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Padding="14">
                                    <StackPanel Spacing="10">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="用视频自制" />

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                x:Name="FxSourceBox"
                                                IsReadOnly="True"
                                                PlaceholderText="选择视频、GIF或帧文件夹" />
                                            <Button
                                                Grid.Column="1"
                                                MinWidth="92"
                                                Click="FxBrowseFile_Click"
                                                Content="视频/GIF" />
                                            <Button
                                                Grid.Column="2"
                                                MinWidth="80"
                                                Click="FxBrowseFolder_Click"
                                                Content="文件夹" />
                                            <StackPanel
                                                Grid.Column="3"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <Button
                                                    x:Name="FxBuildButton"
                                                    MinWidth="128"
                                                    Click="FxBuildButton_Click"
                                                    Content="生成发动特效"
                                                    Style="{StaticResource AccentButtonStyle}" />
                                                <Button
                                                    x:Name="FxRestoreButton"
                                                    Click="FxRemoveButton_Click"
                                                    Content="复原" />
                                                <Button
                                                    x:Name="FxCancelButton"
                                                    Click="FxCancelButton_Click"
                                                    Content="取消"
                                                    Visibility="Collapsed" />
                                            </StackPanel>
                                        </Grid>

                                        <!--  参数: 三列定宽 + 三条弹簧（同召唤动画页），最右一格放声音开关，与帧数同行  -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="136" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="136" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="136" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <NumberBox
                                                x:Name="FxFramesBox"
                                                Header="帧数"
                                                Maximum="200"
                                                Minimum="4"
                                                SmallChange="1"
                                                SpinButtonPlacementMode="Inline"
                                                Value="60" />
                                            <NumberBox
                                                x:Name="FxCellBox"
                                                Grid.Column="2"
                                                Header="每帧高度（px）"
                                                Maximum="2048"
                                                Minimum="128"
                                                SmallChange="10"
                                                SpinButtonPlacementMode="Inline"
                                                Value="1080" />
                                            <NumberBox
                                                x:Name="FxDurBox"
                                                Grid.Column="4"
                                                Header="时长（秒）"
                                                Maximum="15"
                                                Minimum="0.4"
                                                SmallChange="0.1"
                                                SpinButtonPlacementMode="Inline"
                                                Value="1.6" />
                                            <CheckBox
                                                x:Name="FxAudioBox"
                                                Grid.Column="6"
                                                Margin="0,0,0,6"
                                                VerticalAlignment="Bottom"
                                                Content="用视频自带的声音"
                                                IsChecked="True" />
                                        </Grid>
                                        <TextBlock
                                            Margin="0,-4,0,0"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="声音会被写进一个游戏里已存在的音效槽，用同一个槽的别的卡也会跟着变。"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!--  音效: 常显，不折叠  -->
                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource WellBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Padding="14">
                                    <StackPanel Spacing="10">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="音效" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="发动特效播放的声音。换成自己的 WAV 会改掉整个音效槽，用同一个槽的别的卡也会跟着变。"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="SoundCurrentText"
                                            Text="这张卡没有发动特效"
                                            TextWrapping="Wrap" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox
                                                x:Name="SoundSlotBox"
                                                MinWidth="0"
                                                DisplayMemberPath="Text"
                                                Header="音效槽"
                                                HorizontalAlignment="Stretch" />
                                            <Button
                                                x:Name="SoundInjectButton"
                                                Grid.Column="1"
                                                VerticalAlignment="Bottom"
                                                Click="SoundInject_Click"
                                                Content="换一个音效文件…" />
                                            <Button
                                                x:Name="SoundUseButton"
                                                Grid.Column="2"
                                                VerticalAlignment="Bottom"
                                                Click="SoundUse_Click"
                                                Content="改用别的音效槽" />
                                            <Button
                                                x:Name="SoundRestoreButton"
                                                Grid.Column="3"
                                                VerticalAlignment="Bottom"
                                                Click="SoundRestore_Click"
                                                Content="还原" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </StackPanel>
                    </Grid>
                </ScrollViewer>

            </Grid>
        </Border>
        </Grid>

        <!--  忙碌遮罩：生成 / 导入 / 移除期间挡住整页操作（含切换「召唤动画 / 发动特效」），
              左侧导航在窗口壳里，不受影响。取消按钮放在遮罩上，否则长任务就没法中断了  -->
        <Grid
            x:Name="BusyOverlay"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Background="Transparent"
            Visibility="Collapsed">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Opacity="0.7" />
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14">
                <ProgressRing
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Center"
                    IsActive="True" />
                <Button
                    HorizontalAlignment="Center"
                    Click="OverlayCancel_Click"
                    Content="取消" />
            </StackPanel>
        </Grid>

        <!--  底部：进度与日志, 横跨左右两栏  -->
        <StackPanel
            x:Name="StatusStrip"
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Spacing="6"
            Visibility="Collapsed">
            <!--  空闲时折叠: 进度条轨道本身就是一条整宽横线, 留着会被当成多余的分隔线  -->
            <ProgressBar
                x:Name="Progress"
                Height="2"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="StatusText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="就绪" />

        </StackPanel>
    </Grid>
</Page>
