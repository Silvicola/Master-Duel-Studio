<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MDStudio.Pages.AnimPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MDStudio.Converters"
    xmlns:models="using:MDStudio.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StatusBrushConverter x:Key="StatusBrush" />

        <!--
            参数框的上下调节按钮。NumberBox 内置的那两枚是框架主题字典里编译期绑定的样式，
            固定 32px 宽、两枚加间距吃掉 76px，四列参数框里太挤，App 级同名样式覆盖不到。
            所以内置按钮关掉，用这枚 18×22 的窄按钮代替，两枚只要 40px。
        -->
        <Style x:Key="NarrowSpinButton" TargetType="RepeatButton">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

    </Page.Resources>

    <Grid Padding="24,8,24,24" ColumnSpacing="12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--
            模式：改召唤动画 / 改卡牌特效。提到页面级而不是放在卡片详情里，
            因为这一维决定左边能搜到哪一类卡 —— 召唤动画只存在于怪兽卡上。
            放详情里的话，必须先选中一张卡才看得见开关，就切不出来了。
        -->
        <SelectorBar
            x:Name="SectionBar"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,-8,0,0"
            SelectionChanged="SectionBar_SelectionChanged">
            <!--
                默认选中态只管一条 3px 细线，文字颜色与未选中相同（都指向
                TextFillColorPrimaryBrush），两个页签分不出来。这里让选中项用强调色，
                下划线也用强调色，才有明确的“当前在哪一页”的线索。
            -->
            <SelectorBar.Resources>
                <SolidColorBrush x:Key="SelectorBarItemForegroundSelected" Color="{ThemeResource SystemAccentColor}" />
                <SolidColorBrush x:Key="SelectorBarItemPillFill" Color="{ThemeResource SystemAccentColor}" />
            </SelectorBar.Resources>
            <SelectorBarItem
                IsSelected="True"
                Tag="cutin"
                Text="修改召唤动画" />
            <SelectorBarItem x:Name="FxTab" Tag="runfx" Text="修改卡牌特效" />
        </SelectorBar>

        <!--  左：卡片列表  -->
        <Grid Grid.Row="1">
            <!--  三层阶梯投影：ThemeShadow 在 Mica 窗口里不渲染，靠透明度递减模拟柔和衰减  -->
            <Border
                Margin="0,0,10,10"
                Background="{ThemeResource ElevationShadowBrush}"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Opacity="0.025">
                <Border.RenderTransform>
                    <TranslateTransform X="4" Y="6" />
                </Border.RenderTransform>
            </Border>
            <Border
                Margin="0,0,10,10"
                Background="{ThemeResource ElevationShadowBrush}"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Opacity="0.04">
                <Border.RenderTransform>
                    <TranslateTransform X="2.5" Y="4" />
                </Border.RenderTransform>
            </Border>
            <Border
                Margin="0,0,10,10"
                Background="{ThemeResource ElevationShadowBrush}"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Opacity="0.055">
                <Border.RenderTransform>
                    <TranslateTransform X="1" Y="2" />
                </Border.RenderTransform>
            </Border>
            <Border
                x:Name="LeftPanel"
                Margin="0,0,10,10"
                Background="{ThemeResource PanelFillBrush}"
                BorderBrush="{ThemeResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
            <Grid Padding="12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox
                    x:Name="SearchBox"
                    PlaceholderText="搜索卡名或编号"
                    TextChanged="SearchBox_TextChanged" />

                <!--
                    按状态筛选. 条目随上面的模式换：改召唤动画时列动画的五档，
                    改卡牌特效时列特效的五档。两个维度不该同时出现 —— 一屏里出现
                    「全部动画 / 全部特效」两个下拉，用户会以为要同时满足。
                    带星号的（官方动画★ / 官方特效★）是「借用同名卡那套」，跟自己带的官方、跟自改
                    都不是一回事，所以单列一档；取色仍按官方走，不另起颜色。
                    不设「全部」：列表里每一行必然属于其中一档，再给个全部只多一次点击。
                -->
                <ComboBox
                    x:Name="StatusFilterBox"
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="FilterBox_SelectionChanged">
                    <ComboBoxItem Content="官方动画" Tag="official" />
                </ComboBox>

                <!--  筛出来是空的时候, 光靠底部那行字容易看成卡住了  -->
                <TextBlock
                    x:Name="EmptyHint"
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="没有符合条件的卡"
                    Visibility="Collapsed" />

                <!--
                    右侧留 ScrollBarSize(16)：WinUI 的滚动条是覆盖式浮层，
                    条目横向撑满会被它压住，选中框右边就被裁掉一截。
                -->
                <ListView
                    x:Name="CardList"
                    Grid.Row="2"
                    Padding="0,0,16,0"
                    ContainerContentChanging="CardList_ContainerContentChanging"
                    SelectionChanged="CardList_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Grid x:Name="RootGrid">
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <!--
                                                        每个状态都显式写全 背景/边框/指示条 三个属性。
                                                        留空的 VisualState 不会把上一个状态动画过的值复位，
                                                        旧高亮就会残留到别的行上。
                                                    -->
                                                    <VisualState x:Name="Normal">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TransparentBrush}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TransparentBrush}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="PointerOver">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TransparentBrush}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="Pressed">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TransparentBrush}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <!--
                                                        命名必须用 ListViewItem 的真实状态名：PointerOverSelected / PressedSelected。
                                                        写成 SelectedPointerOver 不会命中，鼠标停在选中项上会回落到 PointerOver 的灰底。
                                                    -->
                                                    <VisualState x:Name="Selected">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardSelectedBackground}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardSelectedBorder}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="PointerOverSelected">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardSelectedBackground}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardSelectedBorder}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="PressedSelected">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardSelectedBackground}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardSelectedBorder}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                            <Border
                                                x:Name="SelectionBorder"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle
                                                        x:Name="Indicator"
                                                        Grid.Column="0"
                                                        Fill="{ThemeResource CardSelectedIndicatorBrush}"
                                                        Opacity="0" />
                                                    <ContentPresenter
                                                        Grid.Column="1"
                                                        Margin="{TemplateBinding Padding}"
                                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                        Content="{TemplateBinding Content}"
                                                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:CardItem">
                            <Grid Padding="12,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        MaxLines="1"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind IdText}" />
                                </StackPanel>
                                <!--
                                    状态标签: 只显示当前模式那一维, 另一半在这里没有信息量。
                                    「特殊卡」跟状态标签并排: 它说的是「这个维度根本不适用」,
                                    不是「还没有」。特殊卡自己也带不了别的标签。
                                -->
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                        Text="未上线"
                                        ToolTipService.ToolTip="{x:Bind LockTip}"
                                        Visibility="{x:Bind UnreleasedVisibility}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Text="卡型未确认"
                                        ToolTipService.ToolTip="{x:Bind LockTip}"
                                        Visibility="{x:Bind UnknownSubtypeVisibility}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        Text="特殊卡"
                                        ToolTipService.ToolTip="{x:Bind SpecialTip}"
                                        Visibility="{x:Bind SpecialVisibility}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                        Text="来源卡"
                                        ToolTipService.ToolTip="{x:Bind DonorTip}"
                                        Visibility="{x:Bind DonorVisibility}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{x:Bind KindCurrent, Converter={StaticResource StatusBrush}}"
                                        Text="{x:Bind TagCurrent}"
                                        ToolTipService.ToolTip="{x:Bind TagTipCurrent}"
                                        Visibility="{x:Bind StatusTagVisibility}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--  统计放在列表下面，和卡片页同一处；底部状态条只留给进度和报错  -->
                <TextBlock
                    x:Name="CountText"
                    Grid.Row="3"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
        </Grid>

        <!--  右：选中卡的工作台  -->
        <Grid Grid.Row="1" Grid.Column="1">
            <!--  三层阶梯投影，与左面板同一套节奏  -->
            <Border
                Margin="0,0,10,10"
                Background="{ThemeResource ElevationShadowBrush}"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Opacity="0.025">
                <Border.RenderTransform>
                    <TranslateTransform X="4" Y="6" />
                </Border.RenderTransform>
            </Border>
            <Border
                Margin="0,0,10,10"
                Background="{ThemeResource ElevationShadowBrush}"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Opacity="0.04">
                <Border.RenderTransform>
                    <TranslateTransform X="2.5" Y="4" />
                </Border.RenderTransform>
            </Border>
            <Border
                Margin="0,0,10,10"
                Background="{ThemeResource ElevationShadowBrush}"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Opacity="0.055">
                <Border.RenderTransform>
                    <TranslateTransform X="1" Y="2" />
                </Border.RenderTransform>
            </Border>
            <Border
                x:Name="RightPanel"
                Margin="0,0,10,10"
                Background="{ThemeResource PanelFillBrush}"
                BorderBrush="{ThemeResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
            <!--  右内边距故意比左小 14：给 ScrollViewer 的浮层滚动条留槽，
                  内容本身靠 ScrollViewer 的 Padding 补回 24，左右仍然对齐  -->
            <Grid Padding="24,24,10,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ScrollViewer
                    x:Name="DetailScroller"
                    Grid.Row="0"
                    HorizontalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <!--  右侧 Margin 14 给 ScrollViewer 的浮层滚动条留槽（ScrollViewer.Padding 在模板里不生效）  -->
                    <Grid x:Name="DetailContent" Margin="0,0,14,0">
                        <!--  空状态  -->
                        <StackPanel
                            x:Name="EmptyState"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="从左边选一张卡" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="选中后这里会显示这张卡的召唤动画或卡牌特效" />
                        </StackPanel>

                        <!--  卡片详情  -->
                        <StackPanel
                            x:Name="DetailPanel"
                            Spacing="12"
                            Visibility="Collapsed">
                            <!--
                                卡名 + 卡号在左，刷新 / 复原在右，两个模式共用这一行。
                                以前这两个按钮放在内容流里（来源卡面板之后），三种卡状态的面板
                                高度不同，按钮就跟着上下漂；特效页还各自复制了一枚「复原」。
                                提到这里之后位置固定，也不再需要每个区块各挂一枚。
                            -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="10">
                                    <!--
                                        卡名卡号用只读 TextBox：TextBlock 的
                                        IsTextSelectionEnabled 在 WinUI 3 里拖选不动。
                                        去掉边框底色后看起来就是一行字。
                                    -->
                                    <TextBox
                                        x:Name="CardName"
                                        MaxWidth="440"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="28"
                                        FontWeight="SemiBold"
                                        IsReadOnly="True"
                                        IsSpellCheckEnabled="False"
                                        Text="—"
                                        TextWrapping="NoWrap">
                                        <TextBox.Resources>
                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                        </TextBox.Resources>
                                    </TextBox>
                                    <TextBox
                                        x:Name="CardMeta"
                                        MinHeight="0"
                                        Padding="0"
                                        VerticalAlignment="Bottom"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        IsReadOnly="True"
                                        IsSpellCheckEnabled="False"
                                        Text="—"
                                        TextWrapping="NoWrap">
                                        <TextBox.Resources>
                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                        </TextBox.Resources>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        x:Name="RefreshButton"
                                        Height="32"
                                        MinWidth="96"
                                        Click="RefreshButton_Click"
                                        Content="刷新" />
                                    <Button
                                        x:Name="RestoreButton"
                                        Height="32"
                                        MinWidth="96"
                                        Click="Restore_Click"
                                        Content="复原" />
                                </StackPanel>
                            </Grid>

                            <!--
                                一句话交代这张卡现在的状态、动了会影响谁。四种状态都写，
                                位置固定在标题下方，不会因为有没有来源卡面板而上下移。
                            -->
                            <TextBlock
                                x:Name="StateLine"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />


                            <StackPanel x:Name="CutinSection" Spacing="12">
                            <StackPanel x:Name="DonorPanel" Spacing="8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock VerticalAlignment="Center" Text="来源卡" />
                                        <AutoSuggestBox
                                            x:Name="DonorBox"
                                            MinWidth="240"
                                            PlaceholderText="搜卡名或编号"
                                            TextMemberPath="Display"
                                            SuggestionChosen="DonorBox_SuggestionChosen"
                                            TextChanged="DonorBox_TextChanged">
                                            <AutoSuggestBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:CardItem">
                                                    <TextBlock Text="{x:Bind Display}" />
                                                </DataTemplate>
                                            </AutoSuggestBox.ItemTemplate>
                                        </AutoSuggestBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock VerticalAlignment="Center" Text="源卡预设" />
                                        <ComboBox
                                            x:Name="DonorPresetBox"
                                            MinWidth="130"
                                            PlaceholderText="按召唤类型选"
                                            SelectionChanged="DonorPresetBox_SelectionChanged" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    x:Name="DonorHint"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!--  生成召唤动画  -->
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource WellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="从视频/GIF/帧文件夾导入" />

                                    <!--  素材行  -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="SourceBox"
                                            IsReadOnly="True"
                                            PlaceholderText="选择视频、GIF或帧文件夾" />
                                        <Button
                                            x:Name="BrowseFileButton"
                                            Grid.Column="1"
                                            MinWidth="92"
                                            Click="BrowseFile_Click"
                                            Content="视频/GIF" />
                                        <Button
                                            x:Name="BrowseFolderButton"
                                            Grid.Column="2"
                                            MinWidth="80"
                                            Click="BrowseFolder_Click"
                                            Content="文件夾" />
                                        <StackPanel
                                            Grid.Column="3"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Button
                                                x:Name="BuildButton"
                                                MinWidth="128"
                                                Click="BuildButton_Click"
                                                Content="生成召唤动画"
                                                Style="{StaticResource AccentButtonStyle}" />
                                            <Button
                                                x:Name="CancelButton"
                                                Click="CancelButton_Click"
                                                Content="取消"
                                                Visibility="Collapsed" />
                                        </StackPanel>
                                    </Grid>

                                    <!--  方案 + 超分 + 弹出: 同一行。
                                         三个下拉的列改成 Auto，各自用 MinWidth 兜底：宽度跟着内容走，
                                         不会截字，也不会像定死 136 那样把最右一列挤出可视区。
                                         省下的宽度仍用三根弹簧均分，左右两端贴齐整块控件的边。  -->
                                    <Grid x:Name="TopRowGrid" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition x:Name="EffectColumn" Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Text="方案"
                                            ToolTipService.ToolTip="一组画面参数，选中即填好帧数、像素、尺寸" />
                                        <ComboBox
                                            x:Name="SchemeBox"
                                            Grid.Column="1"
                                            MinWidth="124"
                                            HorizontalAlignment="Stretch"
                                            DropDownClosed="SchemeBox_DropDownClosed"
                                            SelectionChanged="SchemeBox_SelectionChanged" />
                                        <StackPanel
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                            <Button
                                                x:Name="SchemeSaveButton"
                                                Click="SchemeSave_Click"
                                                ToolTipService.ToolTip="保存为方案"
                                                Width="34"
                                                Height="32"
                                                Padding="0">
                                                <FontIcon
                                                    FontSize="16"
                                                    Foreground="#0F7B0F"
                                                    Glyph="&#xE74E;" />
                                            </Button>
                                            <Button
                                                x:Name="SchemeDeleteButton"
                                                Click="SchemeDelete_Click"
                                                ToolTipService.ToolTip="删除选中的方案"
                                                Width="34"
                                                Height="32"
                                                Padding="0">
                                                <FontIcon
                                                    FontSize="16"
                                                    Foreground="#C42B1C"
                                                    Glyph="&#xE74D;" />
                                            </Button>
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="4"
                                            VerticalAlignment="Center"
                                            Text="超分"
                                            ToolTipService.ToolTip="先用 AI 把每帧放大再缩回，只补细节，生成更慢" />
                                        <ComboBox
                                            x:Name="UpscaleBox"
                                            Grid.Column="5"
                                            MinWidth="104"
                                            HorizontalAlignment="Stretch"
                                            SelectedIndex="0"
                                            SelectionChanged="UpscaleBox_SelectionChanged"
                                            VerticalAlignment="Center">
                                            <ComboBoxItem Content="关闭" Tag="0" />
                                            <ComboBoxItem Content="超分 2×" Tag="2" />
                                            <ComboBoxItem Content="超分 4×" Tag="4" />
                                        </ComboBox>

                                        <StackPanel
                                            Grid.Column="7"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="弹出"
                                                ToolTipService.ToolTip="按关键帧缩放，可在「效果」里自定义" />
                                            <CheckBox
                                                x:Name="PopBox" MinWidth="0" Padding="0"
                                                VerticalAlignment="Center"
                                                Checked="PopBox_Toggled"
                                                Unchecked="PopBox_Toggled" />
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="CurveLabel"
                                            Grid.Column="9"
                                            VerticalAlignment="Center"
                                            Text="效果"
                                            Visibility="Collapsed" />
                                        <ComboBox
                                            x:Name="CurvePresetBox"
                                            Grid.Column="10"
                                            MinWidth="96"
                                            HorizontalAlignment="Stretch"
                                            SelectedIndex="0"
                                            ToolTipService.ToolTip="默认：25% 淡入起步，约三分之一处冲到 108%，回落到 76%，缓回 90% 收尾。自定义可以自己写关键帧。"
                                            Visibility="Collapsed"
                                            SelectionChanged="CurvePresetBox_SelectionChanged">
                                            <ComboBoxItem Content="默认" />
                                            <ComboBoxItem Content="自定义" />
                                        </ComboBox>
                                    </Grid>

                                    <!--  参数: 四列定宽 + 三条弹簧，行内左右两端仍贴齐整块控件的边。
                                         定宽是为了让框本身收短（纯等分时框会把整列撑满），
                                         弹簧吃掉剩下的宽度，相邻两框之间因此有均匀的空隙。  -->
                                    <Grid
                                        x:Name="ParamsGrid"
                                        RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="136" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="136" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="136" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="136" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <NumberBox x:Name="FramesBox" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" Header="帧数" Maximum="200" Minimum="4" SpinButtonPlacementMode="Inline" Value="120" ToolTipService.ToolTip="总帧数。帧数 ÷ 时长 = 每秒帧数，72 帧配 1.6 秒就是 45fps。越多越顺，图集也越大；一张装不下会分两页，两页还装不下就得减帧数或减边长。" />
                                        <NumberBox x:Name="DurBox" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch" Header="时长（秒）" Maximum="15" Minimum="0.4" SmallChange="0.1" SpinButtonPlacementMode="Inline" Value="4.8" ToolTipService.ToolTip="动画播多久。游戏里那段 Timeline 会被拉到这个长度，改长改短都生效。" />
                                        <NumberBox x:Name="CellBox" Grid.Row="0" Grid.Column="4" HorizontalAlignment="Stretch" Header="像素/帧" Maximum="4096" Minimum="128" SmallChange="10" SpinButtonPlacementMode="Inline" Value="1664" ToolTipService.ToolTip="每帧贴图的边长（正方形）。只影响清晰度和包体大小，不改屏幕上大小。角色在屏幕上越大，这个值越该跟着大：调小会糊，调大只是白占空间。4096 是游戏官方素材的上限，再大没有画质收益。实际能用多大还看帧数：一页装不下会自动分两页，两页还装不下会提示减帧数或减这个值。" />
                                        <NumberBox x:Name="SizeBox" Grid.Row="0" Grid.Column="6" HorizontalAlignment="Stretch" Header="角色尺寸" Maximum="8000" Minimum="500" SmallChange="50" SpinButtonPlacementMode="Inline" Value="2930" ToolTipService.ToolTip="骨骼宽度，决定动画在屏幕上多大。4800 大约铺满 16:9 屏宽，2930 是常用档。" />
                                        <NumberBox x:Name="OffXBox" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" Header="左右移（帧图 px）" SmallChange="10" SpinButtonPlacementMode="Inline" ToolTipService.ToolTip="以帧图像素计：填「像素/帧」那个数正好挪一个帧图宽，正数向右。跟「角色尺寸」一起缩放。" Value="0" />
                                        <NumberBox x:Name="OffYBox" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" Header="上下移（帧图 px）" SmallChange="10" SpinButtonPlacementMode="Inline" ToolTipService.ToolTip="以帧图像素计：填「像素/帧」那个数正好挪一个帧图高，正数向上。跟「角色尺寸」一起缩放。" Value="0" />
                                        <NumberBox x:Name="RotBox" Grid.Row="1" Grid.Column="4" HorizontalAlignment="Stretch" Header="旋转（度）" Maximum="180" Minimum="-180" SmallChange="1" SpinButtonPlacementMode="Inline" Value="0" ToolTipService.ToolTip="整张图绕中心转，正数逆时针，跟 Spine 的约定一致。" />
                                        <NumberBox x:Name="ZoomBox" Grid.Row="1" Grid.Column="6" HorizontalAlignment="Stretch" Header="放大倍数" Maximum="4" Minimum="0.2" SmallChange="0.1" SpinButtonPlacementMode="Inline" Value="1.1" ToolTipService.ToolTip="整体倍率，1 是不缩放。和「角色尺寸」一起决定最终多大，弹出那一下的幅度也跟着缩放。" />
                                    </Grid>

                                </StackPanel>
                            </Border>

                            <!--  从 Spine 导入  -->
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource WellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="从 Spine 导入" />

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="SpineSourceBox"
                                            IsReadOnly="True"
                                            PlaceholderText="Spine 导出文件夹、zip 或 bundle" />
                                        <Button
                                            Grid.Column="1"
                                            Click="SpineBrowseFolder_Click"
                                            Content="文件夹…" />
                                        <Button
                                            Grid.Column="2"
                                            Click="SpineBrowseFile_Click"
                                            Content="文件…" />
                                        <Button
                                            x:Name="SpineImportButton"
                                            Grid.Column="3"
                                            Click="SpineImportButton_Click"
                                            Content="导入到这张卡"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            </StackPanel>

                            <!--  发动特效  -->
                            <StackPanel x:Name="RunfxSection" Spacing="12" Visibility="Collapsed">
                                <!--  时机分页: 有特效的卡按游戏已配的时机分, 无特效的卡只有一页  -->
                                <SelectorBar
                                    x:Name="FxTimingBar"
                                    SelectionChanged="FxTimingBar_SelectionChanged" />

                                <!--  用视频自制: 只换动画, 声音在下面单独管  -->
                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource WellBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Padding="14">
                                    <StackPanel Spacing="10">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="用视频自制" ToolTipService.ToolTip="下面这些参数在点「生成发动特效」时生效，改完要重新生成。只换动画，声音在下面单独管。" />

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                x:Name="FxSourceBox"
                                                IsReadOnly="True"
                                                PlaceholderText="选择视频、GIF或帧文件夹" />
                                            <Button
                                                Grid.Column="1"
                                                MinWidth="92"
                                                Click="FxBrowseFile_Click"
                                                Content="视频/GIF" />
                                            <Button
                                                Grid.Column="2"
                                                MinWidth="80"
                                                Click="FxBrowseFolder_Click"
                                                Content="文件夹" />
                                            <StackPanel
                                                Grid.Column="3"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <Button
                                                    x:Name="FxBuildButton"
                                                    MinWidth="128"
                                                    Click="FxBuildButton_Click"
                                                    Content="生成发动特效"
                                                    Style="{StaticResource AccentButtonStyle}" />
                                                <Button
                                                    x:Name="FxCancelButton"
                                                    Click="FxCancelButton_Click"
                                                    Content="取消"
                                                    Visibility="Collapsed" />
                                            </StackPanel>
                                        </Grid>

                                        <!--  参数：两行四列。第一行生成参数，第二行画面调节。
                                              第二行四个跟第一行一样只在点「生成发动特效」时写入，
                                              不再提供生成后单独改的入口（那条路会就地改写已生成的 bundle）  -->
                                        <Grid ColumnSpacing="12" RowSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <NumberBox
                                                x:Name="FxFramesBox"
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Header="帧数"
                                                Maximum="200"
                                                Minimum="4"
                                                SmallChange="1"
                                                SpinButtonPlacementMode="Inline"
                                                Value="60" ToolTipService.ToolTip="从素材里均匀抽多少帧。越多越流畅，图集也越大。" />
                                            <NumberBox
                                                x:Name="FxDurBox"
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Header="时长（秒）"
                                                Maximum="15"
                                                Minimum="0.4"
                                                SmallChange="0.1"
                                                SpinButtonPlacementMode="Inline"
                                                Value="2" ToolTipService.ToolTip="整段特效播多久。跟帧数一起决定每秒放几帧。" />
                                            <ComboBox
                                                x:Name="FxQualityBox"
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Header="每帧高度（px）"
                                                HorizontalAlignment="Stretch"
                                                SelectedIndex="1"
                                                ToolTipService.ToolTip="图集里每一帧贴图缩到多少像素高。只影响清晰度和图集体积，不改变画面在屏幕上的大小。">
                                                <ComboBoxItem Content="720" Tag="720" />
                                                <ComboBoxItem Content="1080" Tag="1080" />
                                                <ComboBoxItem Content="1440" Tag="1440" />
                                            </ComboBox>
                                            <ComboBox
                                                x:Name="FxUpscaleBox"
                                                Grid.Row="0"
                                                Grid.Column="3"
                                                Header="超分"
                                                HorizontalAlignment="Stretch"
                                                SelectedIndex="0"
                                                SelectionChanged="FxUpscaleBox_SelectionChanged"
                                                ToolTipService.ToolTip="先用超分把每帧放大再缩回原尺寸，边缘更锐。关闭就不跑，省时间。">
                                                <ComboBoxItem Content="关闭" Tag="0" />
                                                <ComboBoxItem Content="×2" Tag="2" />
                                                <ComboBoxItem Content="×4" Tag="4" />
                                            </ComboBox>

                                            <NumberBox
                                                x:Name="FxSizeBox"
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Header="画面大小"
                                                Maximum="1.5"
                                                Minimum="0.1"
                                                SmallChange="0.05"
                                                SpinButtonPlacementMode="Inline"
                                                Value="0.5" ToolTipService.ToolTip="按屏幕宽度算：1.0 就是画面宽度等于屏幕宽度。正方形素材高度会超出屏幕，16:9 素材正好铺满。" />
                                            <NumberBox
                                                x:Name="FxOffXBox"
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Header="左右移（% 屏宽）"
                                                Minimum="-75"
                                                Maximum="75"
                                                SmallChange="5"
                                                SpinButtonPlacementMode="Inline"
                                                ToolTipService.ToolTip="按屏幕宽度算：填 25 就是屏宽的四分之一，正数向右。与分辨率、画面大小无关。"
                                                Value="0" />
                                            <NumberBox
                                                x:Name="FxOffYBox"
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                Header="上下移（% 屏高）"
                                                Minimum="-75"
                                                Maximum="75"
                                                SmallChange="5"
                                                SpinButtonPlacementMode="Inline"
                                                ToolTipService.ToolTip="按屏幕高度算：填 25 就是屏高的四分之一，正数向上。与分辨率、画面大小无关。"
                                                Value="0" />
                                            <NumberBox
                                                x:Name="FxRotBox"
                                                Grid.Row="1"
                                                Grid.Column="3"
                                                Header="旋转（度）"
                                                Maximum="180"
                                                Minimum="-180"
                                                SmallChange="1"
                                                SpinButtonPlacementMode="Inline"
                                                Value="0" ToolTipService.ToolTip="平面内旋转，正数逆时针。" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!--  音效: 三选一, 每项展开自己的内容  -->
                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource WellBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Padding="14">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="音效" />
                                            <TextBlock
                                                x:Name="FxSoundStatus"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Button
                                                x:Name="FxSoundRestoreButton"
                                                Grid.Column="2"
                                                Click="FxSoundRestore_Click"
                                                Content="复原音效"
                                                IsEnabled="False" />
                                        </Grid>

                                        <!--  拍平后整块靠这个容器一起禁用；StackPanel 是 Panel，没有 IsEnabled  -->
                                        <ContentControl x:Name="FxSoundBody" HorizontalContentAlignment="Stretch">
                                            <StackPanel Spacing="14">

                                            <!--  官方音效：换成游戏里已有的槽。本卡原音只读展示，复原走右上角按钮。
                                                  原来这里有一行恒定的「官方音效」小标题，每切一张卡都不变，
                                                  下面的「本卡原音：X」已经把这件事说清楚了，属于无效文字，删掉让内容上抬  -->
                                            <StackPanel Spacing="4">
                                                <TextBlock
                                                    x:Name="FxOriginText"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    TextWrapping="Wrap" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button
                                                        x:Name="FxOfficialPickButton"
                                                        Grid.Column="0"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Click="FxOfficialPick_Click"
                                                        Content="选择音效…" />
                                                    <Button
                                                        x:Name="FxOfficialPreviewButton"
                                                        Grid.Column="1"
                                                        MinWidth="72"
                                                        Click="FxPreviewOfficial_Click"
                                                        Content="试听"
                                                        IsEnabled="False" />
                                                    <Button
                                                        x:Name="FxApplyOfficialButton"
                                                        Grid.Column="2"
                                                        MinWidth="72"
                                                        Click="FxApplyOfficial_Click"
                                                        Content="应用"
                                                        IsEnabled="False" />
                                                </Grid>
                                            </StackPanel>

                                            <!--  自改音效：预设、导入自己的音频，或游戏里别人的槽  -->
                                            <StackPanel Spacing="6">
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="自改音效" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button
                                                        x:Name="FxPresetPickButton"
                                                        Grid.Column="0"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Click="FxPresetPick_Click"
                                                        Content="选择预设或导入…" />
                                                    <Button
                                                        x:Name="FxPreviewButton"
                                                        Grid.Column="1"
                                                        MinWidth="72"
                                                        Click="FxPreview_Click"
                                                        Content="试听"
                                                        IsEnabled="False" />
                                                    <Button
                                                        x:Name="FxApplyPresetButton"
                                                        Grid.Column="2"
                                                        MinWidth="72"
                                                        Click="FxApplyPreset_Click"
                                                        Content="应用"
                                                        IsEnabled="False"
                                                        ToolTipService.ToolTip="把选中的素材写进这张卡" />
                                                </Grid>
                                            </StackPanel>
                                            </StackPanel>
                                        </ContentControl>

                                        <TextBlock
                                            x:Name="FxSoundHintText"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </StackPanel>
                    </Grid>
                </ScrollViewer>

            </Grid>
        </Border>
        </Grid>

        <!--  忙碌遮罩：生成 / 导入 / 移除期间挡住整页操作（含切换「召唤动画 / 发动特效」），
              左侧导航在窗口壳里，不受影响。取消按钮放在遮罩上，否则长任务就没法中断了  -->
        <Grid
            x:Name="BusyOverlay"
            Grid.RowSpan="3"
            Grid.ColumnSpan="2"
            Margin="-24,-8,-24,-24"
            Background="Transparent"
            Visibility="Collapsed">
            <!--
                负 Margin 抵消根 Grid 的 Padding="24,8,24,24"，让遮罩铺满整个内容区：
                左到导航右边缘、上到标题栏下边缘、右和下到窗口边缘。改 Padding 时这里要一起改
                （卡图页顶部是 55，那里对应 -55，两页不是同一个数）。
                左上角跟内容区圆角一致（8px），另外三个角贴着窗口边缘，交给窗口圆角处理。
            -->
            <Border
                Background="{ThemeResource SmokeFillColorDefaultBrush}"
                CornerRadius="8,0,0,0" />
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14">
                <ProgressRing
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Center"
                    IsActive="True" />
                <Button
                    Click="OverlayCancel_Click"
                    Content="取消"
                    Style="{StaticResource OverlayCancelButton}" />
            </StackPanel>
        </Grid>

        <!--  底部：进度与日志, 横跨左右两栏  -->
        <StackPanel
            x:Name="StatusStrip"
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Padding="20,8,20,12"
            Spacing="6"
            Visibility="Collapsed">
            <!--  空闲时折叠: 进度条轨道本身就是一条整宽横线, 留着会被当成多余的分隔线  -->
            <ProgressBar
                x:Name="Progress"
                Height="2"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="StatusText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="就绪" />

        </StackPanel>
    </Grid>
</Page>
