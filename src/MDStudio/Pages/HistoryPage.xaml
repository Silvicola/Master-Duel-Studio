<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MDStudio.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MDStudio.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <StackPanel Grid.Row="0" Padding="20,16,20,4" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="历史" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="这个工具做过的所有改动。撤销会连带撤掉建在它上面的后续改动。" />
        </StackPanel>

        <!--  记录列表与操作  -->
        <Grid Grid.Row="1" Padding="20,8,20,8" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListView
                x:Name="HistoryList"
                Grid.Row="0"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:HistoryItem">
                        <Grid
                            Padding="0,6"
                            ColumnSpacing="16"
                            ToolTipService.ToolTip="{x:Bind Tip}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Time}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind OpText}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="2"
                                Text="{x:Bind CardText}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="3"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind From}"
                                VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                <Button
                    x:Name="UndoSelectedBtn"
                    Click="UndoSelected_Click"
                    Content="撤销选中的" />
                <Button
                    x:Name="UndoLastBtn"
                    Click="UndoLast_Click"
                    Content="撤销最近一条" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="撤销不可逆。同一张卡上建在它后面的改动会一起被撤掉。" />
            </StackPanel>
        </Grid>

        <!--  底部：进度与日志  -->
        <StackPanel
            x:Name="StatusStrip"
            Grid.Row="2"
            Padding="20,8,20,12"
            Spacing="6"
            Visibility="Collapsed">
            <!--  空闲时折叠: 进度条轨道本身就是一条整宽横线, 留着会被当成多余的分隔线  -->
            <ProgressBar
                x:Name="Progress"
                Height="2"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="StatusText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="就绪" />
            <Expander
                x:Name="LogExpander"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="日志"
                IsExpanded="False">
                <StackPanel HorizontalAlignment="Stretch" Spacing="6">
                    <Button
                        x:Name="CopyLogButton"
                        HorizontalAlignment="Right"
                        Click="CopyLog_Click"
                        Content="复制全部" />
                    <ListView
                        x:Name="LogList"
                        HorizontalAlignment="Stretch"
                        MaxHeight="160"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    IsTextSelectionEnabled="True"
                                    Text="{Binding}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Expander>
        </StackPanel>
    </Grid>
</Page>
