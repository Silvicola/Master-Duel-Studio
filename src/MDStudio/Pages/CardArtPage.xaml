<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MDStudio.Pages.CardArtPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MDStudio.Controls"
    xmlns:converters="using:MDStudio.Converters"
    xmlns:models="using:MDStudio.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StatusBrushConverter x:Key="StatusBrush" />
        <DataTemplate x:Key="CardRow" x:DataType="models:CardItem">
            <Grid Padding="12,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock
                        MaxLines="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind SubText}" />
                </StackPanel>
                <!--  右侧状态标签：未上线 / 卡型未确认 / 超框状态（四态互斥，带★表示覆盖了官方那套）  -->
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                        Text="未上线"
                        ToolTipService.ToolTip="{x:Bind LockTip}"
                        Visibility="{x:Bind UnreleasedVisibility}" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="卡型未确认"
                        ToolTipService.ToolTip="{x:Bind LockTip}"
                        Visibility="{x:Bind UnknownSubtypeVisibility}" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{x:Bind KindArt, Converter={StaticResource StatusBrush}}"
                        Text="{x:Bind ArtTag}"
                        ToolTipService.ToolTip="{x:Bind ArtTagTip}"
                        Visibility="{x:Bind ArtTagVisibility}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,55,24,24" ColumnSpacing="12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左：卡片列表（PanelCard 模板已含 10px 投影边距，别再加 Margin，否则比右栏小一圈）  -->
        <ContentControl
            Grid.Row="0"
            Style="{StaticResource PanelCard}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox
                    x:Name="SearchBox"
                    PlaceholderText="搜索卡名或编号"
                    TextChanged="SearchBox_TextChanged"
                    />

                <!--
                    筛选档位，四档互斥且完备，每张可见卡必然落在其中一档：
                    官方超框 = 游戏本来就有，自改超框 = 工具写入的（官方原本有没有都算这档，
                    来历看行标签的悬停），无超框 = 本来就没有也没改过，未上线 = 游戏还没放出来。
                    不设「全部」：再给个全部只多一次点击。默认停在「官方超框」。
                    未上线单独一档，三个超框档里不再出现未上线的卡。
                -->
                <ComboBox
                    x:Name="ArtFilterBox"
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="ArtFilterBox_SelectionChanged">
                    <ComboBoxItem Content="官方超框" Tag="official" />
                    <ComboBoxItem Content="自改超框" Tag="self" />
                    <ComboBoxItem Content="无超框" Tag="none" />
                    <ComboBoxItem Content="未上线" Tag="unreleased" />
                </ComboBox>

                <TextBlock
                    x:Name="EmptyHint"
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="没有符合条件的卡"
                    Visibility="Collapsed" />

                <!--  右侧留 16 给浮层式滚动条，否则选中框右边会被压住  -->
                <ListView
                    x:Name="CardList"
                    Grid.Row="2"
                    Padding="0,0,16,0"
                                                                                SelectionChanged="CardList_SelectionChanged"
                    ItemTemplate="{StaticResource CardRow}"
                                                                
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Grid x:Name="RootGrid">
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <!--  六个状态都要写全 背景/边框/指示条，留空会残留上一态的值  -->
                                                    <VisualState x:Name="Normal">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TransparentBrush}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TransparentBrush}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="PointerOver">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TransparentBrush}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="Pressed">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TransparentBrush}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <!--  真实状态名是 PointerOverSelected / PressedSelected  -->
                                                    <VisualState x:Name="Selected">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardSelectedBackground}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardSelectedBorder}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="PointerOverSelected">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardSelectedBackground}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardSelectedBorder}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="PressedSelected">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardSelectedBackground}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardSelectedBorder}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                            <Border
                                                x:Name="SelectionBorder"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle
                                                        x:Name="Indicator"
                                                        Grid.Column="0"
                                                        Fill="{ThemeResource CardSelectedIndicatorBrush}"
                                                        Opacity="0" />
                                                    <ContentPresenter
                                                        Grid.Column="1"
                                                        Margin="{TemplateBinding Padding}"
                                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                        Content="{TemplateBinding Content}"
                                                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <TextBlock
                    x:Name="CountText"
                    Grid.Row="3"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </ContentControl>

        <!--  右：工作台  -->
        <ContentControl
            Grid.Row="0"
            Grid.Column="1"
            Padding="18"
            Style="{StaticResource PanelCard}">
            <!--  右侧：卡片信息头 + 内容  -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  第一行：卡片信息（卡名 + 卡号）+ 刷新 / 复原  -->
                <Grid Grid.Row="0" Margin="0,0,0,4" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <!--
                            用只读 TextBox 而不是 TextBlock：WinUI 3 里 TextBlock 的
                            IsTextSelectionEnabled 设了也拖选不动（实测没有选中态），
                            而只读 TextBox 天然支持拖选和 Ctrl+C。去掉边框和底色后
                            看起来就是一行文字。
                        -->
                        <TextBox
                            x:Name="CardName"
                            MaxWidth="440"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="28"
                            FontWeight="SemiBold"
                            IsReadOnly="True"
                            IsSpellCheckEnabled="False"
                            Text="选一张卡"
                            TextWrapping="NoWrap">
                            <!--  只读也要装作不是输入框：悬停和聚焦时都不变色  -->
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            </TextBox.Resources>
                        </TextBox>
                        <TextBox
                            x:Name="CardMeta"
                            MinHeight="0"
                            Padding="0"
                            VerticalAlignment="Bottom"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsReadOnly="True"
                            IsSpellCheckEnabled="False"
                            Text=""
                            TextWrapping="NoWrap">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="RefreshButton"
                            Height="32"
                            MinWidth="96"
                            Click="RefreshButton_Click"
                            Content="刷新" />
                        <Button
                            x:Name="RestoreButton"
                            Height="32"
                            MinWidth="96"
                            Click="RevertBtn_Click"
                            Content="复原"
                            IsEnabled="False" />
                    </StackPanel>
                </Grid>


                <!--  超框工作台：预览 + 参数，限一个最大宽度，窄窗口下按比例收缩  -->
                <Grid x:Name="OverframeSection" Grid.Row="2">
                <Grid
                    x:Name="OfPanel"
                    MaxWidth="860"
                    Margin="0,16,0,0"
                    ColumnSpacing="26"
                    HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                <!--  预览：宽度固定 288，卡片按 704:1024 等比缩放到这个宽度里，
                      线框跟着卡片走，不随窗口高度变化  -->
                <Grid
                    x:Name="PreviewHost"
                    Width="288"
                    RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--
                        卡位固定 704:1024 的比例（288 × 419）。没选卡时显示虚线空位，
                        选了卡就换成真卡图，两者占同一块地方，切换时页面不跳。
                    -->
                    <Grid
                        x:Name="PreviewSlot"
                        Height="419"
                        VerticalAlignment="Top">
                        <Rectangle
                            x:Name="EmptySlot"
                            Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                            StrokeDashArray="3 3"
                            StrokeThickness="1"
                            RadiusX="12"
                            RadiusY="12" />
                        <Viewbox
                            x:Name="CardView"
                            Stretch="Uniform"
                            VerticalAlignment="Top"
                            Visibility="Collapsed">
                            <!--  细线贴着卡片走：线框包着画布，跟着 704:1024 一起缩放，
                                  不再随面板高度拉伸。厚度按设计像素给（300 宽下约 1.3px）  -->
                            <!--  圆角取卡图实测的 26（卡图坐标），细线厚度 3，所以外角给 29，
                                  内边正好裁在 26，卡图和细线一起走圆角  -->
                            <Border
                                Background="Transparent"
                                BorderBrush="{ThemeResource TextFillColorSecondaryBrush}"
                                BorderThickness="3"
                                CornerRadius="29">
                                <Canvas
                                    x:Name="CardCanvas"
                                    Width="704"
                                    Height="1024"
                                    Background="Transparent"
                                    PointerCaptureLost="CardCanvas_PointerCaptureLost"
                                    PointerMoved="CardCanvas_PointerMoved"
                                    PointerPressed="CardCanvas_PointerPressed"
                                    PointerReleased="CardCanvas_PointerReleased">
                                    <!--  背景卡图：Cover 填满插图窗  -->
                                    <Rectangle
                                        x:Name="ArtRect"
                                        Width="527"
                                        Height="528"
                                        IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <!--  卡框：棱彩用配色框，其余用原生框  -->
                                    <Image
                                        x:Name="FrameImg"
                                        Width="704"
                                        Height="1024"
                                        IsHitTestVisible="False" />
                                    <!--  虹彩：整圈艳彩虹  -->
                                    <Image
                                        x:Name="BorderRainbowImg"
                                        Width="704"
                                        Height="1024"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed" />
                                    <!--  幻彩：柔和淡彩环带  -->
                                    <Image
                                        x:Name="BorderGloryImg"
                                        Width="704"
                                        Height="1024"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed" />
                                    <!--  官方：还原官方超框  -->
                                    <Image
                                        x:Name="BorderOfficialImg"
                                        Width="704"
                                        Height="1024"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed" />
                                    <!--  连接箭头：未点亮层压在主体下面，会被主体盖住  -->
                                    <Image
                                        x:Name="LinkDimImg"
                                        Width="704"
                                        Height="1024"
                                        IsHitTestVisible="False"
                                        Opacity="1" />
                                    <!--  主体：放大冲框，不压效果栏；可鼠标拖动  -->
                                    <Canvas
                                        x:Name="SubjectLayer"
                                        Width="704"
                                        Height="1024"
                                        IsHitTestVisible="False">
                                        <Canvas.Clip>
                                            <RectangleGeometry Rect="0,0,704,1024" />
                                        </Canvas.Clip>
                                        <Image x:Name="SubjectImg" IsHitTestVisible="False" />
                                    </Canvas>
                                    <!--  连接箭头点亮层在主之上  -->
                                    <Image
                                        x:Name="LinkLitImg"
                                        Width="704"
                                        Height="1024"
                                        IsHitTestVisible="False" />
                                    <!--  效果框：单独压主体之上，透明度可调  -->
                                    <Image
                                        x:Name="LoreImg"
                                        Width="704"
                                        Height="1024"
                                        IsHitTestVisible="False"
                                        Opacity="1" />
                                </Canvas>
                            </Border>
                        </Viewbox>
                        <TextBlock
                            x:Name="PreviewHint"
                            Margin="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="从左边选一张卡"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>

                    <TextBlock
                        x:Name="PreviewCaption"
                        Grid.Row="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Grid>

                <!--  参数：一个两列网格，第 0 列放控件、第 1 列放按钮与读数，
                      四行的左右边缘因此完全对齐  -->
                <Grid Grid.Column="1">
                <ScrollViewer
                    x:Name="EditPane"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <!--  参数自成一块：浅底圆角、宽高都跟着可用空间走-->
                    <Border
                        MaxWidth="546"
                        Padding="16"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        BorderBrush="{ThemeResource WellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  卡图背景  -->
                            <TextBlock
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                Margin="0,0,0,6"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="卡图背景（填满插图窗）"
                                ToolTipService.ToolTip="卡图会填满插图窗；主体放大后会跨出框线，压在最上层。" />
                            <TextBox
                                x:Name="FrameArtBox"
                                Grid.Row="2"
                                IsReadOnly="True"
                                PlaceholderText="不选就用游戏当前卡图" />
                            <Button
                                Grid.Row="2"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Click="PickFrameArt_Click"
                                Content="选择…" />

                            <!--  主体  -->
                            <TextBlock
                                Grid.Row="3"
                                Grid.ColumnSpan="2"
                                Margin="0,18,0,6"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="主体（推荐带透明通道的 PNG）"
                                ToolTipService.ToolTip="没有透明通道的图片会整块盖住卡片；不选主体就没有出框效果。" />
                            <TextBox
                                x:Name="SubjectBox"
                                Grid.Row="4"
                                IsReadOnly="True"
                                PlaceholderText="不给就没有出框" />
                            <Button
                                Grid.Row="4"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Click="PickSubject_Click"
                                Content="选择…" />

                            <!--  边框效果  -->
                            <TextBlock
                                Grid.Row="5"
                                Grid.ColumnSpan="2"
                                Margin="0,18,0,6"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="边框效果" />
                            <controls:WheelSafeComboBox
                                x:Name="EffectBox"
                                Grid.Row="6"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="EffectBox_SelectionChanged" />
                            <!--  写入就近放在它要用的参数旁边，不再吊在整页最底下  -->
                            <Button
                                x:Name="ApplyBtn"
                                Grid.Row="6"
                                Grid.Column="1"
                                MinWidth="96"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                Click="ApplyBtn_Click"
                                Content="生成超框"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}" />

                            <!--  主体大小  -->
                            <TextBlock
                                Grid.Row="7"
                                Grid.ColumnSpan="2"
                                Margin="0,18,0,6"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="主体大小" />
                            <Slider
                                x:Name="SubjectScaleSlider"
                                Grid.Row="8"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                IsThumbToolTipEnabled="False"
                                Maximum="3"
                                Minimum="0.5"
                                StepFrequency="0.1"
                                Value="1"
                                ValueChanged="Tune_ValueChanged"
                                />
                            <TextBlock
                                x:Name="ScaleText"
                                Grid.Row="8"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="1.0×" />

                            <!--  效果框透明度  -->
                            <TextBlock
                                Grid.Row="9"
                                Grid.ColumnSpan="2"
                                Margin="0,18,0,6"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="效果框透明度" />
                            <Slider
                                x:Name="LoreAlphaSlider"
                                Grid.Row="10"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                IsThumbToolTipEnabled="False"
                                Maximum="1"
                                Minimum="0.2"
                                StepFrequency="0.01"
                                Value="1"
                                ValueChanged="LoreAlpha_ValueChanged"
                                />
                            <TextBlock
                                x:Name="LoreText"
                                Grid.Row="10"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="100%" />
                        </Grid>
                    </Border>
                </ScrollViewer>

                <!--
                    只看态：控件整块收起后，这里说明为什么改不了，别让右栏一片空白。
                    外形沿用参数面板的浅底圆角块，切过来时位置和大小都对得上。
                -->
                <Border
                    x:Name="ReadOnlyNote"
                    MaxWidth="546"
                    Padding="16"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="{ThemeResource LayerFillColorAltBrush}"
                    BorderBrush="{ThemeResource WellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                    <StackPanel Spacing="6">
                        <TextBlock
                            x:Name="ReadOnlyTitle"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="这张卡不能改" />
                        <TextBlock
                            x:Name="ReadOnlyText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text=""
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                </Grid>
                </Grid>
                </Grid>

            </Grid>
        </ContentControl>

        <!--  忙碌遮罩：写入 / 撤回期间挡住整页操作，左侧导航在窗口壳里，不受影响  -->
        <Grid
            x:Name="BusyOverlay"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Margin="-24,-55,-24,-24"
            Background="Transparent"
            Visibility="Collapsed">
            <!--
                负 Margin 逐边抵消根 Grid 的 Padding="24,55,24,24"，让遮罩铺满 NavFrame
                的整个内容区（标题栏与左侧导航在窗口壳里，本来就不归它管）。
                顶部的 55 是上一轮为了把面板顶边对齐动画页的切换标签加出来的，
                当时只改了根 Grid 的 Padding，这里仍留着旧值 -8，于是遮罩上边内缩 47px，
                标题栏下方漏出一条没被盖住的亮带。改根 Grid 的 Padding 时必须同步改这里。
                蒙层用 Smoke，原来用的是卡片底色 + 0.7 不透明度，那是浅色主题下最接近页面
                自身的颜色，叠上去几乎看不出变化，容易被当成「遮罩没出来」。
            -->
            <Border
                Background="{ThemeResource SmokeFillColorDefaultBrush}"
                CornerRadius="8,0,0,0" />
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14">
                <ProgressRing
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Center"
                    IsActive="True" />
                <Button
                    Click="OverlayCancel_Click"
                    Content="取消"
                    Style="{StaticResource OverlayCancelButton}" />
            </StackPanel>
        </Grid>

        <!--  底部状态  -->
        <StackPanel
            x:Name="StatusStrip"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Padding="20,8,20,12"
            Spacing="6"
            Visibility="Collapsed">
            <ProgressBar
                x:Name="Progress"
                Height="2"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="StatusText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>
    </Grid>
</Page>

