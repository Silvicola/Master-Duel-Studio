<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MDStudio.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MDStudio">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>

            <!--
                面板底色保持原样（等于 LayerFillColorDefault 的观感），只是写成不透明：
                投影层铺在面板下方，半透明底色会把黑底透上来，整块面板被染灰。
                ThemeDictionaries 必须排在普通资源之前。
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PanelFillBrush" Color="#FCFCFC" />
                    <!-- 分区描边：只加实边缘，不改底色 -->
                    <SolidColorBrush x:Key="WellBorderBrush" Color="#D8D8D8" />
                    <!-- 历史页四档类别配色（浅色版，2026-11-17 用户定稿：组 1）。
                         动画紫 / 特效青 / 超框玫粉 / 复原与其他灰。
                         每档 Badge 浅底 / Text 深字 / Bar 浅色条；Other 兼作复原徽标。
                         暗色版在下面的 Dark 字典里，键名一一对应。 -->
                    <SolidColorBrush x:Key="HistBadgeAnim" Color="#EEEDFE" />
                    <SolidColorBrush x:Key="HistTextAnim" Color="#3C3489" />
                    <SolidColorBrush x:Key="HistBarAnim" Color="#AFA9EC" />
                    <SolidColorBrush x:Key="HistBadgeFx" Color="#E1F5EE" />
                    <SolidColorBrush x:Key="HistTextFx" Color="#04342C" />
                    <SolidColorBrush x:Key="HistBarFx" Color="#5DCAA5" />
                    <SolidColorBrush x:Key="HistBadgeArt" Color="#FBEAF0" />
                    <SolidColorBrush x:Key="HistTextArt" Color="#4B1528" />
                    <SolidColorBrush x:Key="HistBarArt" Color="#ED93B1" />
                    <SolidColorBrush x:Key="HistBadgeOther" Color="#F1EFE8" />
                    <SolidColorBrush x:Key="HistTextOther" Color="#5F5E5A" />
                    <SolidColorBrush x:Key="HistBarOther" Color="#D3D1C7" />
                    <!--  历史页筛选胶囊的选中态  -->
                    <SolidColorBrush x:Key="ChipCheckedBgBrush" Color="#E6F1FB" />
                    <SolidColorBrush x:Key="ChipCheckedBorderBrush" Color="#378ADD" />
                    <SolidColorBrush x:Key="ChipCheckedTextBrush" Color="#0C447C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PanelFillBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="WellBorderBrush" Color="#3F3F3F" />
                    <!-- 暗色版：同色系的深底 + 亮字，色条取中间阶，避免浅色块发亮 -->
                    <SolidColorBrush x:Key="HistBadgeAnim" Color="#3C3489" />
                    <SolidColorBrush x:Key="HistTextAnim" Color="#CECBF6" />
                    <SolidColorBrush x:Key="HistBarAnim" Color="#534AB7" />
                    <SolidColorBrush x:Key="HistBadgeFx" Color="#04342C" />
                    <SolidColorBrush x:Key="HistTextFx" Color="#5DCAA5" />
                    <SolidColorBrush x:Key="HistBarFx" Color="#0F6E56" />
                    <SolidColorBrush x:Key="HistBadgeArt" Color="#4B1528" />
                    <SolidColorBrush x:Key="HistTextArt" Color="#F4C0D1" />
                    <SolidColorBrush x:Key="HistBarArt" Color="#993556" />
                    <SolidColorBrush x:Key="HistBadgeOther" Color="#444441" />
                    <SolidColorBrush x:Key="HistTextOther" Color="#D3D1C7" />
                    <SolidColorBrush x:Key="HistBarOther" Color="#5F5E5A" />
                    <SolidColorBrush x:Key="ChipCheckedBgBrush" Color="#0C447C" />
                    <SolidColorBrush x:Key="ChipCheckedBorderBrush" Color="#185FA5" />
                    <SolidColorBrush x:Key="ChipCheckedTextBrush" Color="#B5D4F4" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 选中态：底色只做轻微提亮，识别靠边框与左侧指示条；跟随系统强调色 -->
            <SolidColorBrush x:Key="CardSelectedBackground" Color="{ThemeResource SystemAccentColor}" Opacity="0.09" />
            <SolidColorBrush x:Key="CardSelectedBorder" Color="{ThemeResource SystemAccentColor}" />
            <!-- Rectangle.Fill 要 Brush，直接给 SystemAccentColor（Color）不会生效 -->
            <SolidColorBrush x:Key="CardSelectedIndicatorBrush" Color="{ThemeResource SystemAccentColor}" />
            <!-- 离开选中态时用来复位，Storyboard 里给字符串 "Transparent" 不会自动转成 Brush -->
            <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
            <!-- 面板描边：比默认 CardStroke 更实，拉开层次 -->
            <SolidColorBrush x:Key="PanelBorderBrush" Color="{ThemeResource SystemBaseMediumLowColor}" />
            <!-- 投影底色：纯黑，靠每层 Border 自己的 Opacity 做阶梯衰减 -->
            <SolidColorBrush x:Key="ElevationShadowBrush" Color="Black" />
            <!-- 导航选中底色：跟随系统强调色 -->
            <SolidColorBrush x:Key="NavSelectedBackground" Color="{ThemeResource SystemAccentColor}" Opacity="0.14" />

            <!--
                忙碌遮罩上的「取消」。动画页和卡图页共用这一套，改这里两处一起变。
                遮罩是 Smoke 深色层，普通按钮压上去几乎看不见，而这是遮罩里唯一能点的
                东西，必须一眼找到，所以用强调色底、比常规按钮高一点。
            -->
            <Style x:Key="OverlayCancelButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="Height" Value="36" />
            </Style>

            <!--
                带柔和投影的面板容器，外观与卡片页两个主面板一致：
                不透明底 + 更实的描边 + 三层递减透明度模拟投影。
                用法：<ContentControl Style="{StaticResource PanelCard}">内容</ContentControl>
            -->
            <Style x:Key="PanelCard" TargetType="ContentControl">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Grid>
                                <Border
                                    Margin="0,0,10,10"
                                    Background="{ThemeResource ElevationShadowBrush}"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                                    Opacity="0.025">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="4" Y="6" />
                                    </Border.RenderTransform>
                                </Border>
                                <Border
                                    Margin="0,0,10,10"
                                    Background="{ThemeResource ElevationShadowBrush}"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                                    Opacity="0.04">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="2.5" Y="4" />
                                    </Border.RenderTransform>
                                </Border>
                                <Border
                                    Margin="0,0,10,10"
                                    Background="{ThemeResource ElevationShadowBrush}"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                                    Opacity="0.055">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="1" Y="2" />
                                    </Border.RenderTransform>
                                </Border>
                                <Border
                                    Margin="0,0,10,10"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{ThemeResource PanelFillBrush}"
                                    BorderBrush="{ThemeResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                                    <ContentPresenter
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Content="{TemplateBinding Content}" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
